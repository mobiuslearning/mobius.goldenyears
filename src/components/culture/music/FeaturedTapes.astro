---
import type { Song } from '../../../types';
import SectionHeader from '../../shared/SectionHeader.astro';
import TapePanel from './TapePanel.astro';

interface Props {
  songs: Song[];
  total: number;
  usingFallback?: boolean;
}

const { songs, total, usingFallback = false } = Astro.props;
const half = Math.ceil(songs.length / 2);
const sideA = songs.slice(0, half);
const sideB = songs.slice(half);
---

<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <SectionHeader
      index="01"
      eyebrow="Featured Tapes"
      title="精选磁带，A 面与 B 面"
      description="挑出最常被倒带的那几首，做成两盘精选磁带。A 面是开场，B 面是舍不得跳过的那一首。"
      accent="jade"
    />
    <p class="shrink-0 font-mono text-[10px] tracking-[0.24em] text-ink-faint">
      FEATURED {String(songs.length).padStart(2, '0')} / {String(total).padStart(2, '0')}
    </p>
  </div>

  {
    songs.length > 0 ? (
      <div class="relative mt-10">
        <div class="grid gap-6 lg:grid-cols-2 lg:gap-8">
          <TapePanel side="A" tracks={sideA} startIndex={1} />
          <TapePanel side="B" tracks={sideB} startIndex={sideA.length + 1} />
        </div>
        <div class="relative mt-2 h-6 border-[1.5px] border-ink bg-paper-deep" aria-hidden="true">
          <span class="absolute inset-x-4 top-1.5 h-px bg-ink/15"></span>
          <span class="absolute inset-x-8 top-3 h-px bg-ink/10"></span>
        </div>
        <p class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center font-mono text-[9px] tracking-[0.24em] text-ink-faint">
          <span>TAPE RACK</span>
          <span class="text-ink/25">/</span>
          <span>A 面开场，B 面收尾</span>
          <span class="text-ink/25">/</span>
          <span>{usingFallback ? '暂无精选标记，先听这几首' : '倒带的时候请轻一点'}</span>
        </p>
      </div>
    ) : (
      <div class="mt-10 border-[1.5px] border-dashed border-ink/30 bg-cream/50 px-6 py-16 text-center">
        <p class="font-display text-2xl text-ink">磁带还在录音</p>
        <p class="mt-3 text-sm leading-7 text-ink-soft">精选曲目正在整理中，先去下面的曲库按年份翻一翻。</p>
      </div>
    )
  }
</section>
