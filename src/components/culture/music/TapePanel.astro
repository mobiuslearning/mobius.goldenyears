---
import type { Song } from '../../../types';

interface Props {
  side: 'A' | 'B';
  tracks: Song[];
  startIndex?: number;
}

const { side, tracks, startIndex = 1 } = Astro.props;
const isSideA = side === 'A';
const accentText = isSideA ? 'text-vermilion' : 'text-jade';
const accentBg = isSideA ? 'bg-vermilion' : 'bg-jade';
const maxRows = 7;
const visibleTracks = tracks.slice(0, maxRows);
const overflow = tracks.length - visibleTracks.length;
---

<article
  class="reveal relative border-[1.5px] border-ink bg-cream p-4 shadow-print transition-transform duration-300 hover:-translate-y-1 sm:p-5"
  data-reveal
  style={`--reveal-delay:${side === 'A' ? 0 : 120}ms`}
>
  <span class="absolute left-2 top-2 h-1.5 w-1.5 rounded-full border border-ink/40" aria-hidden="true"></span>
  <span class="absolute right-2 top-2 h-1.5 w-1.5 rounded-full border border-ink/40" aria-hidden="true"></span>
  <span class="absolute bottom-2 left-2 h-1.5 w-1.5 rounded-full border border-ink/40" aria-hidden="true"></span>
  <span class="absolute bottom-2 right-2 h-1.5 w-1.5 rounded-full border border-ink/40" aria-hidden="true"></span>

  <header class="flex items-start justify-between gap-3 border-b-[1.5px] border-ink/20 pb-3">
    <div class="flex items-baseline gap-3">
      <span class:list={['font-display text-4xl leading-none', accentText]}>{side}</span>
      <div>
        <p class="font-mono text-[10px] font-bold uppercase tracking-[0.28em] text-ink">SIDE {side}</p>
        <p class="mt-1 font-mono text-[9px] tracking-[0.2em] text-ink-faint">精选金曲 · COMPILATION</p>
      </div>
    </div>
    <div class="flex flex-col items-end gap-1.5">
      <span class:list={['stamp -rotate-2', accentText]}>FEATURED</span>
      <span class="font-mono text-[8px] tracking-[0.18em] text-ink-faint">C-60 · STEREO</span>
    </div>
  </header>

  <div class="relative mt-4 overflow-hidden border-[1.5px] border-ink bg-night px-4 py-3">
    <div class="pointer-events-none absolute inset-0 opacity-25" aria-hidden="true"
      style="background: repeating-linear-gradient(90deg, rgba(244,236,220,0.16) 0 1px, transparent 1px 9px);"></div>
    <div class="relative flex items-center justify-between gap-3">
      <span
        class="relative grid h-12 w-12 shrink-0 place-items-center rounded-full border border-cream/30 sm:h-14 sm:w-14"
        style="background: repeating-radial-gradient(circle, #2b2017 0 1px, #15100b 1px 3px);"
        aria-hidden="true"
      >
        <span class="absolute h-[72%] w-[72%] rounded-full border border-dashed border-cream/20"></span>
        <span class="h-3 w-3 rounded-full border border-cream/40 bg-night"></span>
      </span>
      <span class="h-[2px] flex-1 bg-gradient-to-r from-cream/10 via-cream/35 to-cream/10" aria-hidden="true"></span>
      <span
        class="relative grid h-12 w-12 shrink-0 place-items-center rounded-full border border-cream/30 sm:h-14 sm:w-14"
        style="background: repeating-radial-gradient(circle, #2b2017 0 1px, #15100b 1px 3px);"
        aria-hidden="true"
      >
        <span class="absolute h-[72%] w-[72%] rounded-full border border-dashed border-cream/20"></span>
        <span class="h-3 w-3 rounded-full border border-cream/40 bg-night"></span>
      </span>
    </div>
    <div class="relative mt-2 flex justify-between font-mono text-[8px] tracking-[0.24em] text-cream/35">
      <span>LEFT</span>
      <span class="text-cream/25">· · · · · · · · ·</span>
      <span>RIGHT</span>
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between border-b border-dashed border-ink/20 pb-2">
    <span class="label-mono text-ink-faint">TRACK LIST</span>
    <span class="font-mono text-[9px] tracking-[0.18em] text-ink-faint">{tracks.length} TRACKS</span>
  </div>

  {
    visibleTracks.length > 0 ? (
      <ol class="mt-1">
        {visibleTracks.map((song, i) => (
          <li class="group flex items-baseline gap-2 border-b border-dashed border-ink/10 py-2 last:border-0">
            <span class:list={['w-5 shrink-0 font-mono text-[10px] font-bold', accentText]}>
              {String(startIndex + i).padStart(2, '0')}
            </span>
            <span class="min-w-0 flex-1 truncate font-display text-[15px] leading-6 text-ink">
              {song.title}
            </span>
            <span class="shrink-0 font-mono text-[10px] tracking-[0.1em] text-ink-faint">
              {song.artist} · {song.year}
            </span>
            {song.audio && (
              <button
                type="button"
                data-audio-toggle
                data-audio-src={song.audio}
                data-audio-title={song.title}
                aria-pressed="false"
                aria-label={`试听 ${song.title}`}
                class="shrink-0 border border-ink/30 px-1.5 py-0.5 font-mono text-[9px] tracking-widest text-ink-soft transition-colors hover:border-ink hover:bg-mustard/40"
              >
                <span data-audio-text>试听</span>
              </button>
            )}
          </li>
        ))}
      </ol>
    ) : (
      <p class="mt-2 py-6 text-center font-mono text-[10px] leading-6 tracking-[0.16em] text-ink-faint">
        本面留白 · 把 A 面再听一遍
      </p>
    )
  }

  {
    overflow > 0 && (
      <p class="mt-1 font-mono text-[9px] tracking-[0.16em] text-ink-faint">
        + 另有 {overflow} 首，见下方曲库
      </p>
    )
  }

  <footer class="mt-3 flex items-center justify-between border-t-[1.5px] border-ink/20 pt-2.5">
    <span class="font-mono text-[8px] tracking-[0.2em] text-ink-faint">MADE IN 1980—2009</span>
    <span class="flex items-center gap-1">
      <span class:list={['inline-block h-1.5 w-1.5 rounded-full', accentBg]} aria-hidden="true"></span>
      <span class="font-mono text-[8px] tracking-[0.2em] text-ink-faint">A / B</span>
    </span>
  </footer>
</article>
