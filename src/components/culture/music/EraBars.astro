---
import type { Song, MusicRegion } from '../../../types';
import { eraOfYear } from '../../../lib/theme';

interface Props {
  songs: Song[];
}

const { songs } = Astro.props;
const total = songs.length;

const eraDefs = [
  { key: '1980s', label: '1980s', years: '1980—1989', accent: 'bg-vermilion', text: 'text-vermilion' },
  { key: '1990s', label: '1990s', years: '1990—1999', accent: 'bg-jade', text: 'text-jade' },
  { key: '2000s', label: '2000s', years: '2000—2009', accent: 'bg-mustard', text: 'text-mustard' },
  { key: 'classic', label: '其他', years: 'OTHER', accent: 'bg-sky', text: 'text-sky' },
] as const;

const rows = eraDefs
  .map((def) => {
    const count = songs.filter((song) => eraOfYear(song.year) === def.key).length;
    const pct = total > 0 ? Math.round((count / total) * 100) : 0;
    return { ...def, count, pct };
  })
  .filter((row) => row.count > 0 || row.key !== 'classic');

const regionOrder: MusicRegion[] = ['华语', '港台', '欧美', '日韩', '其他'];
const regionCounts = regionOrder
  .map((region) => ({ region, count: songs.filter((song) => song.region === region).length }))
  .filter((item) => item.count > 0);

const genreCounts = [...new Set(songs.map((song) => song.genre).filter(Boolean))]
  .map((genre) => ({ genre: genre as string, count: songs.filter((song) => song.genre === genre).length }))
  .sort((a, b) => b.count - a.count || a.genre.localeCompare(b.genre, 'zh'))
  .slice(0, 6);

const span = (() => {
  if (!total) return '—';
  const years = songs.map((song) => song.year);
  return `${Math.min(...years)}—${Math.max(...years)}`;
})();
---

<aside class="border-[1.5px] border-ink bg-cream p-5 shadow-print">
  <div class="flex items-center justify-between gap-3 border-b-[1.5px] border-ink/20 pb-3">
    <h3 class="font-display text-lg text-ink">年代金曲分布</h3>
    <span class="font-mono text-[9px] tracking-[0.22em] text-ink-faint">BY DECADE</span>
  </div>

  <div class="mt-3 flex items-baseline justify-between font-mono text-[10px] tracking-[0.16em] text-ink-faint">
    <span>收录 {String(total).padStart(2, '0')} 首</span>
    <span>{span}</span>
  </div>

  <dl class="mt-4 space-y-4">
    {
      rows.map((row, index) => (
        <div>
          <div class="flex items-baseline justify-between gap-2">
            <dt class="flex items-baseline gap-2">
              <span class:list={['font-mono text-[11px] font-bold tracking-[0.16em]', row.text]}>{row.label}</span>
              <span class="font-mono text-[9px] tracking-[0.12em] text-ink-faint">{row.years}</span>
            </dt>
            <dd class="shrink-0 font-mono text-[11px] tabular-nums text-ink">
              {row.count}
              <span class="text-[9px] text-ink-faint">首 · {row.pct}%</span>
            </dd>
          </div>
          <div class="mt-1.5 h-2.5 border-[1.5px] border-ink/25 bg-paper-deep">
            <div
              class:list={['bar-fill h-full', row.accent]}
              style={`width:${row.pct}%;animation-delay:${index * 90}ms`}
              aria-hidden="true"
            >
            </div>
          </div>
        </div>
      ))
    }
  </dl>

  {
    total > 0 && (
      <div class="mt-5 border-t border-dashed border-ink/20 pt-4">
        {regionCounts.length > 0 && (
          <div>
            <p class="label-mono text-ink-faint">地区 / REGION</p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {regionCounts.map((item) => (
                <li class="border border-ink/25 px-1.5 py-0.5 font-mono text-[9px] tracking-[0.12em] text-ink-soft">
                  {item.region} <span class="text-ink-faint">{item.count}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {genreCounts.length > 0 && (
          <div class="mt-4">
            <p class="label-mono text-ink-faint">曲风 / GENRE</p>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {genreCounts.map((item) => (
                <li class="border border-ink/25 px-1.5 py-0.5 font-mono text-[9px] tracking-[0.12em] text-ink-soft">
                  {item.genre} <span class="text-ink-faint">{item.count}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )
  }
</aside>

<style>
  .bar-fill {
    transform-origin: left center;
    animation: bars-grow 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes bars-grow {
    from {
      transform: scaleX(0.015);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
