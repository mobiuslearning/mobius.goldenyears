---
import type { Song } from '../../../types';
import CoverArt from '../../shared/CoverArt.astro';

interface Props {
  song: Song;
  index: number;
  era: string;
  delay?: number;
}

const { song, index, era, delay = 0 } = Astro.props;

const searchText = [
  song.title,
  song.artist,
  song.album,
  song.year,
  song.region,
  song.genre,
  song.lyric,
  song.description,
  '音乐 歌曲 金曲',
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  data-item
  data-era={era}
  data-region={song.region}
  data-genre={song.genre ?? ''}
  data-search={searchText}
  class="reveal group relative flex gap-3 border-[1.5px] border-ink bg-cream p-3 transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-print"
  data-reveal
  style={`--reveal-delay:${delay}ms`}
>
  <a
    href={`/music/${song.id}/`}
    class="absolute inset-0 z-[1] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-vermilion"
    aria-label={`查看《${song.title}》详情`}
  ></a>

  <div class="w-[84px] shrink-0 self-start sm:w-[92px]">
    <CoverArt title={song.title} subtitle={song.artist} year={song.year} kind="music" ratio="square" />
  </div>

  <div class="min-w-0 flex-1">
    <p class="flex items-center justify-between gap-2 font-mono text-[9px] tracking-[0.2em] text-ink-faint">
      <span>
        TRACK {String(index).padStart(2, '0')}
        <span class="ml-1.5 text-ink/25">·</span>
        <span class="ml-1.5">{song.year}</span>
      </span>
      <span class="shrink-0 text-vermilion opacity-0 transition-opacity duration-200 group-hover:opacity-100">
        详情 →
      </span>
    </p>

    <h3 class="mt-0.5 truncate font-display text-[17px] leading-snug text-ink" title={song.title}>{song.title}</h3>
    <p class="mt-0.5 truncate text-[12px] text-ink-soft">
      {song.artist}{song.album && <span class="text-ink-faint"> · 《{song.album}》</span>}
    </p>

    <div class="mt-1.5 flex flex-wrap items-center gap-1">
      <span class="border border-ink/25 px-1.5 py-0.5 font-mono text-[9px] tracking-[0.1em] text-ink-soft">
        {song.region}
      </span>
      {
        song.genre && (
          <span class="border border-ink/25 bg-mustard/15 px-1.5 py-0.5 font-mono text-[9px] tracking-[0.1em] text-ink-soft">
            {song.genre}
          </span>
        )
      }
    </div>

    {
      song.lyric && (
        <p class="mt-2 border-l-2 border-vermilion/70 pl-2 text-[11.5px] leading-5 text-ink-soft">
          「{song.lyric}」
        </p>
      )
    }

    {
      song.audio && (
        <button
          type="button"
          data-audio-toggle
          data-audio-src={song.audio}
          data-audio-title={song.title}
          aria-pressed="false"
          aria-label={`试听 ${song.title}`}
          class="relative z-10 mt-2 inline-flex items-center gap-1.5 border border-ink/30 px-2 py-1 font-mono text-[9px] tracking-[0.16em] text-ink-soft transition-colors hover:border-ink hover:bg-mustard/30"
        >
          <svg viewBox="0 0 12 12" class="h-2.5 w-2.5" fill="currentColor" aria-hidden="true">
            <path d="M3 1.5 10 6 3 10.5z"></path>
          </svg>
          <span data-audio-text>试听</span>
        </button>
      )
    }
  </div>
</article>
