---
import type { Movie } from '../../../types';
import CoverArt from '../../shared/CoverArt.astro';
import { eraOfYear } from '../../../lib/theme';

interface Props {
  movie: Movie;
  index: number;
}

const { movie, index } = Astro.props;
const era = eraOfYear(movie.year);
const search = [
  movie.title,
  movie.year,
  movie.type,
  movie.region,
  movie.genre,
  movie.director,
  movie.cast,
  movie.quote,
  movie.themeSong?.title,
  movie.themeSong?.artist,
  movie.description,
]
  .filter(Boolean)
  .join(' ');
const tapeNo = String(index + 1).padStart(2, '0');
---

<article
  class="reveal group/poster relative flex flex-col"
  data-reveal
  style={`--reveal-delay:${(index % 4) * 60}ms`}
  data-item
  data-type={movie.type}
  data-era={era}
  data-region={movie.region}
  data-search={search}
>
  <a href={`/movies/${movie.id}/`} class="flex flex-1 flex-col" aria-label={`打开《${movie.title}》的影片档案`}>
  <!-- 海报：像贴在录像厅墙上的那一张 -->
  <div
    class="relative border-[1.5px] border-cream/25 bg-night-soft p-1.5 transition-[transform,border-color] duration-300 group-hover/poster:-translate-y-1.5 group-hover/poster:border-mustard/70"
  >
    <CoverArt title={movie.title} year={movie.year} kind="movie" label="FILM" seed={`poster-${movie.id}`} />

    <!-- 类型标签 -->
    <span
      class="pointer-events-none absolute right-2.5 top-2.5 z-20 rotate-2 border border-cream/40 bg-night/80 px-1.5 py-0.5 font-mono text-[8px] font-bold tracking-[0.16em] text-cream/80"
    >
      {movie.type}
    </span>

    {movie.featured && (
      <span
        class="pointer-events-none absolute -left-1.5 -top-2 z-20 -rotate-3 border-[1.5px] border-mustard bg-mustard px-1.5 py-0.5 font-mono text-[8px] font-bold tracking-[0.16em] text-ink"
      >
        本周
      </span>
    )}

    <!-- 右上角的录像带编号 -->
    <span class="pointer-events-none absolute -bottom-1.5 -right-1 z-20 rotate-1 border border-cream/30 bg-ink px-1.5 py-0.5 font-mono text-[8px] tracking-[0.12em] text-cream/60">
      VHS {tapeNo}
    </span>

    <span
      class="pointer-events-none absolute inset-x-0 bottom-0 z-20 h-[3px] origin-left scale-x-0 bg-vermilion/80 transition-transform duration-300 group-hover/poster:scale-x-100"
      aria-hidden="true"></span>
  </div>

  <!-- 海报下方的场记牌 -->
  <div class="mt-3 flex flex-1 flex-col px-0.5">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="line-clamp-1 font-display text-[15px] leading-snug text-cream sm:text-base">{movie.title}</h3>
      <span class="shrink-0 font-mono text-[10px] tracking-[0.1em] text-mustard">{movie.year}</span>
    </div>
    <p class="mt-0.5 line-clamp-1 font-mono text-[8.5px] tracking-[0.14em] text-cream/45">
      {movie.genre}
    </p>
    <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 font-mono text-[9px] tracking-[0.08em] text-cream/40">
      <span>{movie.region}</span>
      <span class="h-2.5 w-px bg-cream/20" aria-hidden="true"></span>
      <span>{era.replace('s', '')}S</span>
      {movie.director && (
        <>
          <span class="h-2.5 w-px bg-cream/20" aria-hidden="true"></span>
          <span class="line-clamp-1">导演 {movie.director}</span>
        </>
      )}
    </div>
    {
      movie.cast && (
        <p class="mt-0.5 line-clamp-1 font-mono text-[9px] tracking-[0.06em] text-cream/30">主演 {movie.cast}</p>
      )
    }
    {
      movie.quote && (
        <blockquote class="mt-2 line-clamp-2 border-l border-vermilion/70 pl-2 font-display text-[11.5px] italic leading-5 text-cream/65">
          「{movie.quote}」
        </blockquote>
      )
    }
    <div class="mt-auto flex items-end justify-between gap-1.5 pt-2">
      {
        movie.themeSong ? (
          <div class="inline-flex min-w-0 max-w-full items-center gap-1.5 border border-cream/20 bg-cream/[0.04] px-2 py-1">
            <span class="flex shrink-0 items-center gap-0.5" aria-hidden="true">
              <span class="relative grid h-3 w-3 place-items-center rounded-full border border-mustard/70">
                <span class="h-[3px] w-[3px] rounded-full bg-mustard/80" />
              </span>
              <span class="relative grid h-3 w-3 place-items-center rounded-full border border-mustard/70">
                <span class="h-[3px] w-[3px] rounded-full bg-mustard/80" />
              </span>
            </span>
            <span class="shrink-0 font-mono text-[8px] tracking-[0.14em] text-cream/40">A面</span>
            <span class="truncate font-mono text-[9px] text-cream/65">
              {movie.themeSong.title} · {movie.themeSong.artist}
            </span>
          </div>
        ) : (
          <span />
        )
      }
      <span class="shrink-0 font-mono text-[8px] tracking-[0.14em] text-mustard/70">档案 →</span>
    </div>
  </div>
  </a>
</article>
