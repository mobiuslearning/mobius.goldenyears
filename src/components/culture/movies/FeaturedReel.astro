---
import type { Movie } from '../../../types';
import CoverArt from '../../shared/CoverArt.astro';

interface Props {
  movies: Movie[];
}

const { movies } = Astro.props;
const slides = movies;
const showtimes = ['19:30', '21:40', '23:50'];
const halls = ['1 号厅', '2 号厅', '3 号厅'];
const pad = (value: number) => String(value).padStart(2, '0');
---

<div data-featured-reel class="relative">
  {
    slides.map((movie, index) => (
      <div
        data-featured-slide
        hidden={index > 0}
        role="group"
        aria-roledescription="slide"
        aria-label={`第 ${index + 1} 部：${movie.title}`}
        class="grid gap-8 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:items-center"
      >
        <!-- 大幅海报 -->
        <div class="relative mx-auto w-full max-w-[320px]">
          <div class="relative border-[1.5px] border-cream/30 bg-night-soft p-2 shadow-[10px_10px_0_rgba(0,0,0,0.45)]">
            <CoverArt
              title={movie.title}
              year={movie.year}
              kind="movie"
              label="FEATURE"
              seed={`featured-${movie.id}`}
            />
            <span class="absolute -right-2 -top-3 z-20 rotate-3 border-[1.5px] border-mustard bg-mustard px-2 py-0.5 font-mono text-[9px] font-bold tracking-[0.16em] text-ink">
              今夜放映
            </span>
            <span class="absolute -bottom-2 -left-2 z-20 -rotate-2 border-[1.5px] border-cream/50 bg-cream px-2 py-0.5 font-mono text-[8px] tracking-[0.14em] text-ink">
              录像带 {pad(index + 1)}
            </span>
          </div>
          <p class="mt-4 text-center font-mono text-[9px] tracking-[0.2em] text-cream/30">
            GOLDEN YEARS VIDEO CLUB · TAPE {pad(index + 1)}
          </p>
        </div>

        <!-- 放映信息 -->
        <div>
          <p class="label-mono text-mustard">Feature Presentation · 今夜放映</p>
          <h2 class="mt-2 font-display text-[clamp(2rem,5vw,3.4rem)] leading-[1.05] text-cream">
            {movie.title}
          </h2>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] tracking-[0.16em] text-cream/50">
            <span>{movie.year}</span>
            <span class="text-cream/20" aria-hidden="true">/</span>
            <span>{movie.type}</span>
            <span class="text-cream/20" aria-hidden="true">/</span>
            <span>{movie.region}</span>
            <span class="text-cream/20" aria-hidden="true">/</span>
            <span>{movie.genre}</span>
          </div>

          <p class="mt-4 max-w-xl text-[14px] leading-7 text-cream/65 text-pretty">{movie.description}</p>

          {movie.quote && (
            <blockquote class="mt-4 max-w-xl border-l-2 border-vermilion pl-3 font-display text-[17px] italic leading-8 text-cream/85">
              「{movie.quote}」
            </blockquote>
          )}

          <dl class="mt-4 grid gap-1 text-[12px] leading-6 text-cream/55 sm:grid-cols-2">
            {movie.director && (
              <div class="flex gap-2">
                <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-cream/35">导演</dt>
                <dd>{movie.director}</dd>
              </div>
            )}
            {movie.cast && (
              <div class="flex gap-2 sm:col-span-2">
                <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-cream/35">主演</dt>
                <dd class="line-clamp-1">{movie.cast}</dd>
              </div>
            )}
          </dl>

          {movie.themeSong && (
            <div class="mt-4 inline-flex max-w-full items-center gap-3 border-[1.5px] border-cream/25 bg-cream/[0.04] px-3 py-2">
              <span class="flex shrink-0 items-center gap-1" aria-hidden="true">
                <span class="relative grid h-4 w-4 place-items-center rounded-full border border-mustard/70">
                  <span class="h-1 w-1 rounded-full bg-mustard/80" />
                </span>
                <span class="relative grid h-4 w-4 place-items-center rounded-full border border-mustard/70">
                  <span class="h-1 w-1 rounded-full bg-mustard/80" />
                </span>
              </span>
              <span class="shrink-0 font-mono text-[9px] tracking-[0.18em] text-mustard">A 面 · 主题曲</span>
              <span class="truncate font-display text-sm text-cream/85">
                {movie.themeSong.title}
                <span class="ml-1 font-mono text-[9px] text-cream/45">{movie.themeSong.artist}</span>
              </span>
            </div>
          )}

          <!-- 票根 -->
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-stretch">
            <div class="ticket min-w-0 flex-1 bg-cream px-5 py-3 text-ink">
              <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="font-mono text-[8px] tracking-[0.22em] text-ink-faint">ADMIT ONE · 录像厅</p>
                  <p class="mt-1 truncate font-display text-lg leading-tight">{movie.title}</p>
                </div>
                <div class="shrink-0 text-right font-mono text-[9px] leading-4 text-ink-soft">
                  <p>{showtimes[index % showtimes.length]} · {halls[index % halls.length]}</p>
                  <p>票价 ¥3.00</p>
                  <p>不对号入座</p>
                </div>
              </div>
            </div>
            <div class="ticket flex shrink-0 items-center bg-cream px-5 py-3 text-ink sm:w-44">
              <div class="w-full">
                <p class="font-mono text-[8px] tracking-[0.22em] text-ink-faint">夜场 · 连映两片</p>
                <p class="mt-1 font-display text-base leading-tight">后排靠门</p>
                <p class="mt-0.5 font-mono text-[8px] tracking-[0.16em] text-ink-soft">冷气开放 · 请勿吸烟</p>
              </div>
            </div>
          </div>

          {slides.length > 1 && (
            <div class="mt-6 flex items-center justify-between border-t border-cream/15 pt-4">
              <p class="font-mono text-[10px] tracking-[0.22em] text-cream/35">
                FEATURE <span class="text-mustard" data-featured-pos>01</span> / {pad(slides.length)}
              </p>
              <div class="flex items-center gap-2">
                <div class="hidden gap-1.5 sm:flex">
                  {slides.map((_, dotIndex) => (
                    <button
                      type="button"
                      data-featured-dot
                      data-slide-index={dotIndex}
                      aria-label={`第 ${dotIndex + 1} 部`}
                      aria-pressed={dotIndex === 0}
                      class:list={['h-1.5 w-5 transition-colors', dotIndex === 0 ? 'bg-mustard' : 'bg-cream/25']}
                    />
                  ))}
                </div>
                <button
                  type="button"
                  data-featured-prev
                  aria-label="上一部"
                  class="grid h-8 w-8 place-items-center border-[1.5px] border-cream/30 text-cream/70 transition-colors hover:border-mustard hover:text-mustard"
                >
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="square" />
                  </svg>
                </button>
                <button
                  type="button"
                  data-featured-next
                  aria-label="下一部"
                  class="grid h-8 w-8 place-items-center border-[1.5px] border-cream/30 text-cream/70 transition-colors hover:border-mustard hover:text-mustard"
                >
                  <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" />
                  </svg>
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    ))
  }
</div>
