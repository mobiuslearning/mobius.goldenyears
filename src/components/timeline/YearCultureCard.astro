---
import CoverArt from '../shared/CoverArt.astro';
import type { CoverKind } from '../../lib/theme';

interface Props {
  kind: CoverKind;
  href: string;
  title: string;
  meta: string;
  note?: string;
  year?: number;
  coverSubtitle?: string;
  label: string;
}

const { kind, href, title, meta, note, year, coverSubtitle, label } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col border-[1.5px] border-ink bg-cream p-2 shadow-print-sm transition-transform duration-200 hover:-translate-y-0.5"
>
  <CoverArt kind={kind} title={title} subtitle={coverSubtitle} year={year} seed={href.split('/').filter(Boolean).pop()} class="w-full" />
  <div class="flex min-w-0 flex-1 flex-col px-1 pb-1 pt-2">
    <span class="truncate font-display text-[15px] leading-tight text-ink">{title}</span>
    <span class="mt-0.5 truncate font-mono text-[9.5px] tracking-[0.1em] text-ink-faint">{meta}</span>
    {note && <span class="mt-1.5 line-clamp-2 text-[11px] leading-5 text-ink-soft">{note}</span>}
    <span class="mt-auto flex items-center justify-between pt-2 font-mono text-[9px] tracking-[0.14em] text-ink-faint">
      <span class="transition-colors group-hover:text-vermilion">{label}</span>
      <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
    </span>
  </div>
</a>
