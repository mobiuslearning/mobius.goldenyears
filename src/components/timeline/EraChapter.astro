---
import type { Era } from '../../types';
import { accentMap } from '../../lib/theme';
import Reveal from '../shared/Reveal.astro';

interface Props {
  era: Era;
  index: number;
  count: number;
  china: number;
  global: number;
}

const { era, index, count, china, global } = Astro.props;
const tone = accentMap[era.color];
const chapter = String(index).padStart(2, '0');
const is1980s = era.id === '1980s';
const is1990s = era.id === '1990s';
---

<section
  id={`era-${era.id}`}
  data-era-section
  data-era={era.id}
  class="relative z-10 scroll-mt-[7rem] py-10 sm:py-12 lg:scroll-mt-[10.5rem] lg:py-14"
  aria-label={`${era.label} ${era.name}`}
>
  <Reveal>
    <div class="relative overflow-hidden border-[1.5px] border-ink bg-cream shadow-print">
      <span
        class="pointer-events-none absolute -top-6 right-1 select-none font-display text-[7.5rem] leading-none text-ink/[0.05] sm:text-[10.5rem]"
        aria-hidden="true">{era.label}</span
      >
      <div class="pointer-events-none absolute inset-0 opacity-[0.35] line-grid" aria-hidden="true"></div>

      <div
        class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-center lg:gap-10 lg:p-10"
      >
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span class:list={['font-mono text-[10px] font-bold tracking-[0.3em]', tone.text]}>
              CHAPTER {chapter}
            </span>
            <span class:list={['h-px w-8', tone.bg]} aria-hidden="true"></span>
            <span class="font-mono text-[10px] tracking-[0.28em] text-ink-faint">{era.years}</span>
          </div>

          <h2 class="mt-3 font-display text-[clamp(1.85rem,4.2vw,3rem)] leading-[1.12] text-ink text-balance">
            {era.name}
          </h2>
          <p class="mt-3 max-w-xl text-[14px] leading-7 text-ink-soft text-pretty">{era.mood}</p>

          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span class:list={['stamp', tone.text]}>{era.label}</span>
            <span class="border border-ink/20 bg-paper-deep/40 px-2 py-1 font-mono text-[10px] tracking-[0.12em] text-ink">
              {count} 条记忆
            </span>
            <span class="border border-vermilion/40 px-2 py-1 font-mono text-[10px] tracking-[0.12em] text-vermilion">
              中国 {china}
            </span>
            <span class="border border-sky/60 px-2 py-1 font-mono text-[10px] tracking-[0.12em] text-ink-soft">
              世界 {global}
            </span>
          </div>
        </div>

        <!-- 年代封面：磁带 / 录像厅 / 网吧 -->
        <div class="relative">
          {
            is1980s && (
              <div class="mx-auto w-full max-w-[19rem]">
                <div class="relative aspect-[1.5/1] border-[1.5px] border-ink bg-vermilion shadow-print-sm">
                  <div class="absolute inset-x-[11%] top-[9%] flex items-center justify-between border-[1.5px] border-ink/70 bg-cream/90 px-2.5 py-1.5">
                    <span class="font-mono text-[8px] tracking-[0.26em] text-ink">SIDE A</span>
                    <span class="font-display text-[10px] tracking-[0.16em] text-ink">流金岁月</span>
                    <span class="font-mono text-[8px] tracking-[0.18em] text-ink">90 MIN</span>
                  </div>
                  <div class="absolute bottom-[8%] left-[11%] h-[40%] w-[31%] rounded-full border-2 border-ink/80 bg-night">
                    <div class="absolute inset-[16%] rounded-full border border-cream/35" />
                    <div class="absolute left-1/2 top-1/2 h-[30%] w-[30%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cream" />
                  </div>
                  <div class="absolute bottom-[8%] right-[11%] h-[40%] w-[31%] rounded-full border-2 border-ink/80 bg-night">
                    <div class="absolute inset-[16%] rounded-full border border-cream/35" />
                    <div class="absolute left-1/2 top-1/2 h-[30%] w-[30%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cream" />
                  </div>
                  <div class="absolute bottom-[5%] left-1/2 h-0 w-0 -translate-x-1/2 border-x-[11px] border-b-[9px] border-x-transparent border-b-night/60" />
                  <span class="absolute left-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-cream/60" />
                  <span class="absolute right-1.5 top-1.5 h-1.5 w-1.5 rounded-full bg-cream/60" />
                  <span class="absolute bottom-1.5 left-1.5 h-1.5 w-1.5 rounded-full bg-cream/60" />
                  <span class="absolute bottom-1.5 right-1.5 h-1.5 w-1.5 rounded-full bg-cream/60" />
                </div>
                <p class="mt-2 text-center font-mono text-[9px] tracking-[0.22em] text-ink-faint">
                  磁带 · SIDE A · 翻来覆去地听
                </p>
              </div>
            )
          }

          {
            is1990s && (
              <div class="mx-auto w-full max-w-[19rem]">
                <div class="relative aspect-[1.32/1] border-[1.5px] border-ink bg-night p-2.5 shadow-print-sm">
                  <div class="scanlines relative h-full w-full overflow-hidden border border-cream/25 bg-night">
                    <div class="absolute inset-0 grid grid-cols-6">
                      <span class="bg-cream"></span>
                      <span class="bg-mustard"></span>
                      <span class="bg-jade"></span>
                      <span class="bg-sky"></span>
                      <span class="bg-vermilion"></span>
                      <span class="bg-night-soft"></span>
                    </div>
                    <div class="absolute inset-x-0 bottom-0 flex items-center justify-between border-t border-cream/25 bg-night/95 px-2 py-1.5">
                      <span class="font-mono text-[8px] tracking-[0.2em] text-cream/70">PLAY · 录像厅</span>
                      <span class="font-mono text-[8px] tracking-[0.2em] text-cream/45">E-120</span>
                    </div>
                    <span class="absolute left-2 top-2 font-mono text-[9px] tracking-[0.2em] text-cream/80">CH 03</span>
                    <span class="absolute right-2 top-1.5 h-1.5 w-1.5 rounded-full bg-vermilion" />
                  </div>
                </div>
                <p class="mt-2 text-center font-mono text-[9px] tracking-[0.22em] text-ink-faint">
                  录像厅 · VHS · 快进到打斗那一段
                </p>
              </div>
            )
          }

          {
            !is1980s && !is1990s && (
              <div class="mx-auto w-full max-w-[19rem]">
                <div class="relative aspect-[1.3/1] border-[1.5px] border-ink bg-mustard p-2.5 shadow-print-sm">
                  <div class="relative h-full w-full overflow-hidden border-[1.5px] border-ink bg-cream">
                    <div class="dot-grid absolute inset-0" aria-hidden="true"></div>
                    <div class="absolute inset-x-2 top-2 border border-ink/60 bg-cream">
                      <div class="flex items-center justify-between border-b border-ink/40 bg-jade/15 px-1.5 py-0.5">
                        <span class="font-mono text-[7px] tracking-[0.18em] text-ink">QQ 2003</span>
                        <span class="flex gap-0.5" aria-hidden="true">
                          <span class="h-1.5 w-1.5 border border-ink/50" />
                          <span class="h-1.5 w-1.5 border border-ink/50" />
                          <span class="h-1.5 w-1.5 border border-ink/50" />
                        </span>
                      </div>
                      <div class="space-y-1 p-1.5">
                        <div class="flex items-center gap-1">
                          <span class="h-3 w-3 border border-ink/50 bg-sky/30" />
                          <span class="h-1.5 w-16 bg-ink/15" />
                        </div>
                        <div class="flex justify-end">
                          <span class="h-1.5 w-12 bg-jade/35" />
                        </div>
                        <div class="flex items-center gap-1">
                          <span class="h-3 w-3 border border-ink/50 bg-vermilion/30" />
                          <span class="h-1.5 w-14 bg-ink/15" />
                        </div>
                      </div>
                    </div>
                    <span class="absolute bottom-4 right-5 h-0 w-0 border-l-[7px] border-t-[11px] border-l-transparent border-t-ink" aria-hidden="true" />
                  </div>
                </div>
                <div class="mx-auto -mt-3 flex w-[78%] rotate-[-1.5deg] items-center justify-between border-[1.5px] border-ink bg-cream px-2.5 py-1.5 shadow-print-sm">
                  <span class="font-mono text-[8px] tracking-[0.18em] text-ink">MP3 · 128MB</span>
                  <span class="font-mono text-[8px] tracking-[0.14em] text-ink-faint">网吧 · QQ · 一首歌 4MB</span>
                </div>
              </div>
            )
          }
        </div>
      </div>

      <div class:list={['relative h-[6px] w-full border-t-[1.5px] border-ink', tone.bg]} aria-hidden="true"></div>
    </div>
  </Reveal>
</section>
