---
import { site } from '../../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/+$/, '') || '/';
  if (normalized === '/') return path === '/';
  return path === normalized || path.startsWith(`${normalized}/`);
};
---

<header class="sticky top-0 z-50 border-b-[1.5px] border-ink/15 bg-paper/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${site.title} 首页`}>
      <span class="relative grid h-10 w-10 place-items-center rounded-full border-[1.5px] border-ink bg-ink text-cream shadow-print-sm">
        <span class="absolute inset-1 rounded-full border border-cream/30" />
        <span class="absolute inset-[7px] rounded-full bg-vermilion transition-transform duration-500 group-hover:rotate-180">
          <span class="absolute left-1/2 top-1/2 h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cream" />
        </span>
        <span class="absolute -right-1 -top-1 h-2 w-2 rounded-full bg-mustard ring-2 ring-paper" />
      </span>
      <span class="leading-none">
        <span class="block font-display text-xl tracking-wider text-ink">流金岁月</span>
        <span class="mt-1 block font-mono text-[9px] tracking-[0.32em] text-ink-faint">TIME MACHINE</span>
      </span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="主导航">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'link-underline px-3 py-2 font-mono text-[12px] tracking-[0.14em] transition-colors',
              isActive(item.href) ? 'text-vermilion' : 'text-ink-soft hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-crt-toggle
        class="hidden items-center gap-1.5 border-[1.5px] border-ink/30 px-2.5 py-1.5 font-mono text-[10px] tracking-[0.18em] text-ink-soft transition-colors hover:border-ink hover:text-ink sm:inline-flex"
        aria-pressed="false"
        title="切换复古显像管滤镜"
      >
        <span class="inline-block h-2 w-2 rounded-full bg-jade" data-crt-dot></span>
        CRT
      </button>
      <button
        type="button"
        data-menu-toggle
        class="grid h-9 w-9 place-items-center border-[1.5px] border-ink bg-cream text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="打开菜单"
      >
        <span class="relative block h-3 w-4" data-menu-icon>
          <span class="absolute inset-x-0 top-0 h-[1.5px] bg-ink transition-transform"></span>
          <span class="absolute inset-x-0 top-1/2 h-[1.5px] -translate-y-1/2 bg-ink transition-opacity"></span>
          <span class="absolute inset-x-0 bottom-0 h-[1.5px] bg-ink transition-transform"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t-[1.5px] border-ink/15 bg-paper lg:hidden" data-menu-panel>
    <nav class="mx-auto grid max-w-7xl grid-cols-2 gap-px bg-ink/10 p-px" aria-label="移动端导航">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-baseline justify-between bg-paper px-4 py-3 font-display text-base',
              isActive(item.href) ? 'text-vermilion' : 'text-ink',
            ]}
          >
            <span>{item.label}</span>
            <span class="font-mono text-[9px] tracking-widest text-ink-faint">
              {item.href.replace(/\//g, '').toUpperCase() || 'HOME'}
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</header>
