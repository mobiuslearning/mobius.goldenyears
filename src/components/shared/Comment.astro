---
/**
 * Twikoo 留言板（预留）
 * ------------------------------------------------------------
 * 部署 Twikoo 后端后，二选一：
 *   1. 在 src/data/site.ts 的 site.twikoo.envId 填入环境 ID；
 *   2. 构建时设置环境变量 PUBLIC_TWIKOO_ENV_ID=你的环境ID。
 * 自建后端可把 envId 写成完整地址，并同步修改 site.twikoo.cdn。
 * 未配置时展示「留言板即将开启」的占位卡片，不影响静态构建。
 */
import { site } from '../../data/site';

const envId = site.twikoo.envId || import.meta.env.PUBLIC_TWIKOO_ENV_ID || '';
const configured = Boolean(envId);
const cdn = site.twikoo.cdn;
---

<section id="comments" class="relative scroll-mt-24 border-t-[1.5px] border-ink/15 pt-14">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-mono text-[10px] uppercase tracking-[0.32em] text-vermilion">Guestbook</p>
      <h2 class="mt-2 font-display text-3xl tracking-wide text-ink">留言板</h2>
      <p class="mt-2 text-sm text-ink-soft">说说你还记得的那个年代，或者只是路过打个招呼。</p>
    </div>
    <span class:list={['stamp', configured ? 'text-jade' : 'text-ink-faint']}>
      {configured ? 'TWIKOO ONLINE' : 'TWIKOO · 待接入'}
    </span>
  </div>

  {
    configured ? (
      <div class="mt-8 border-[1.5px] border-ink bg-cream p-4 shadow-print sm:p-6">
        <div id="twikoo-container" class="min-h-[180px]">
          <p class="font-mono text-xs tracking-widest text-ink-faint">正在接入留言板……</p>
        </div>
      </div>
    ) : (
      <div class="mt-8 border-[1.5px] border-dashed border-ink/40 bg-cream/60 p-6 sm:p-8">
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
          <div class="max-w-xl">
            <h3 class="font-display text-xl text-ink">留言板还差最后一步</h3>
            <p class="mt-3 text-sm leading-7 text-ink-soft">
              评论系统已使用 Twikoo 预留好位置。等你在腾讯云函数（或自建服务器）部署好 Twikoo
              后端，把环境 ID 填进配置，这里就会自动亮起来——不需要改动任何页面代码。
            </p>
            <ul class="mt-4 space-y-1.5 font-mono text-[11px] leading-6 tracking-wide text-ink-faint">
              <li>01 · 部署 Twikoo（腾讯云函数 / Vercel / 自建 Docker）</li>
              <li>02 · 在 src/data/site.ts 填写 site.twikoo.envId</li>
              <li>03 · 或构建时注入 PUBLIC_TWIKOO_ENV_ID 环境变量</li>
            </ul>
          </div>
          <div class="shrink-0">
            <div class="ticket flex w-56 flex-col items-center justify-center gap-2 px-6 py-7 text-center">
              <span class="font-mono text-[9px] tracking-[0.3em] text-ink-faint">RESERVED</span>
              <span class="font-display text-2xl tracking-widest text-ink">留言区</span>
              <span class="font-mono text-[9px] tracking-[0.2em] text-ink-faint">SIGNAL PENDING</span>
              <span class="mt-1 h-px w-12 bg-ink/30"></span>
              <span class="font-mono text-[9px] tracking-[0.2em] text-vermilion">COMING SOON</span>
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>

{
  configured && (
    <script define:vars={{ envId, cdn, placeholder: site.twikoo.placeholder }}>
      (() => {
        const boot = () => {
          const init = () => {
            if (!window.twikoo) return;
            window.twikoo.init({
              envId,
              el: '#twikoo-container',
              lang: 'zh-CN',
              path: window.location.pathname,
              placeholder,
            });
          };
          if (window.twikoo) return init();
          const script = document.createElement('script');
          script.src = cdn;
          script.async = true;
          script.onload = init;
          script.onerror = () => {
            const el = document.getElementById('twikoo-container');
            if (el) el.innerHTML = '<p class="font-mono text-xs tracking-widest text-vermilion">留言板加载失败：请检查 Twikoo CDN 或环境 ID。</p>';
          };
          document.head.appendChild(script);
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
        else boot();
      })();
    </script>
  )
}
