---
/** 全局图片灯箱：配合 src/scripts/lightbox.ts 使用。 */
---

  <!-- ============================== 灯箱 ============================== -->
<div
    data-lightbox
    class="hidden fixed inset-0 z-[90] items-center justify-center bg-night/95 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="图片放大预览"
  >
    <button
      type="button"
      data-lightbox-close
      class="absolute right-4 top-4 z-10 grid h-10 w-10 place-items-center border-[1.5px] border-cream/30 bg-night/80 font-mono text-lg text-cream transition-colors hover:border-mustard hover:text-mustard"
      aria-label="关闭预览"
    >
      ×
    </button>
    <button
      type="button"
      data-lightbox-prev
      class="absolute left-3 top-1/2 z-10 grid h-11 w-9 -translate-y-1/2 place-items-center border-[1.5px] border-cream/25 bg-night/70 text-xl text-cream transition-colors hover:border-mustard hover:text-mustard sm:left-4 sm:h-12 sm:w-10"
      aria-label="上一张"
    >
      ←
    </button>
    <button
      type="button"
      data-lightbox-next
      class="absolute right-3 top-1/2 z-10 grid h-11 w-9 -translate-y-1/2 place-items-center border-[1.5px] border-cream/25 bg-night/70 text-xl text-cream transition-colors hover:border-mustard hover:text-mustard sm:right-4 sm:h-12 sm:w-10"
      aria-label="下一张"
    >
      →
    </button>

    <figure class="relative flex max-h-[92vh] w-full max-w-6xl flex-col items-center">
      <div class="relative">
        <img data-lightbox-image alt="" class="max-h-[82vh] max-w-[92vw] border border-cream/20 object-contain shadow-2xl" />
        <span data-lightbox-loading class="absolute inset-0 grid place-items-center bg-night/40 font-mono text-[10px] tracking-[0.24em] text-cream/70">
          LOADING
        </span>
      </div>
      <figcaption class="mt-4 flex w-full max-w-3xl flex-wrap items-center justify-between gap-3 font-mono text-[10px] tracking-[0.14em] text-cream/55">
        <span data-lightbox-caption class="text-left leading-5"></span>
        <span data-lightbox-counter class="shrink-0"></span>
      </figcaption>
    </figure>
  </div>

