---
import type { AccentKey } from '../../lib/theme';
import { accentMap } from '../../lib/theme';

interface Props {
  index?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  accent?: AccentKey;
  align?: 'left' | 'center';
  class?: string;
  id?: string;
}

const {
  index,
  eyebrow,
  title,
  description,
  accent = 'vermilion',
  align = 'left',
  class: className = '',
  id,
} = Astro.props;
const tone = accentMap[accent];
---

<header id={id} class:list={['relative', align === 'center' ? 'text-center' : '', className]}>
  <div class:list={['flex items-center gap-3', align === 'center' ? 'justify-center' : '']}>
    {index && <span class:list={['font-mono text-[11px] font-bold tracking-[0.3em]', tone.text]}>{index}</span>}
    <span class:list={['h-px w-8', tone.bg, 'opacity-60']} aria-hidden="true"></span>
    {eyebrow && <span class="font-mono text-[10px] uppercase tracking-[0.32em] text-ink-faint">{eyebrow}</span>}
  </div>
  <h2 class="mt-3 font-display text-[clamp(1.9rem,4.5vw,3.1rem)] leading-[1.15] tracking-tight text-ink text-balance">
    {title}
  </h2>
  <div class:list={['mt-4 flex items-center gap-2', align === 'center' ? 'justify-center' : '']} aria-hidden="true">
    <span class:list={['h-[3px] w-12', tone.bg]}></span>
    <span class="h-[3px] w-3 bg-ink/40"></span>
    <span class="h-[3px] w-1.5 bg-ink/25"></span>
  </div>
  {
    description && (
      <p
        class:list={[
          'mt-5 max-w-2xl text-[15px] leading-8 text-ink-soft text-pretty',
          align === 'center' ? 'mx-auto' : '',
        ]}
      >
        {description}
      </p>
    )
  }
</header>
