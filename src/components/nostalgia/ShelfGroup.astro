---
/**
 * 后厅陈列之一：小卖部货架。
 * 每件物品像摆在货架上的商品，价签用 item.tag，木头隔板做成货架感。
 */
import type { ExtraGroup } from '../../types';
import { layoutLabels } from './museum';

interface Props {
  group: ExtraGroup;
  index: number;
}

const { group, index } = Astro.props;
const no = String(index + 1).padStart(2, '0');
const rotations = [-1.1, 0.7, -0.4, 1.2, -0.8, 0.5, -1.3, 0.9];
const shelfLabel = index === 0 ? '五毛钱专柜' : '童年专柜';
---
<section class="relative overflow-hidden border-[1.5px] border-ink bg-paper-deep shadow-print">
  <div class="pointer-events-none absolute inset-0 opacity-30 dot-grid" aria-hidden="true"></div>

  <!-- 店招 -->
  <div class="relative border-b-[1.5px] border-ink bg-cream/85">
    <div class="h-2 w-full" style="background:repeating-linear-gradient(90deg, #c23b2a 0 14px, #fbf7ec 14px 28px);" aria-hidden="true"></div>
    <div class="flex flex-wrap items-start justify-between gap-3 px-5 py-4 sm:px-6">
      <div class="min-w-0">
        <p class="font-mono text-[9px] font-bold tracking-[0.26em] text-vermilion">
          外厅 {no} / {layoutLabels.shelf.en}
        </p>
        <h3 class="mt-1.5 font-display text-2xl leading-tight text-ink sm:text-[1.8rem]">{group.title}</h3>
        <p class="mt-1.5 max-w-2xl text-[13px] leading-6 text-ink-soft">{group.subtitle}</p>
      </div>
      <span class="stamp shrink-0 bg-cream text-vermilion">{shelfLabel}</span>
    </div>
  </div>

  <!-- 货架 -->
  <div class="relative px-4 py-6 sm:px-6 sm:py-8">
    {
      group.items.length > 0 ? (
        <ul class="grid grid-cols-2 gap-x-4 gap-y-7 sm:grid-cols-3 sm:gap-x-5">
          {group.items.map((item, itemIndex) => {
            const rot = rotations[itemIndex % rotations.length];
            return (
              <li class="group/shelf flex flex-col">
                <div
                  class="relative flex flex-1 flex-col border-[1.5px] border-ink bg-cream p-3.5 shadow-print-sm transition-transform duration-300 ease-out group-hover/shelf:-translate-y-1"
                  style={`transform:rotate(${rot}deg);`}
                >
                  {/* 价签 */}
                  <span
                    class="absolute -right-2 -top-2 z-10 max-w-[5.5rem] truncate border-[1.5px] border-ink bg-mustard px-1.5 py-0.5 font-mono text-[9px] font-bold tracking-[0.08em] text-ink"
                    style={`transform:rotate(${-rot * 1.7}deg);`}
                  >
                    {item.tag ?? '童年'}
                  </span>
                  <span class="font-mono text-[9px] tracking-[0.18em] text-ink-faint">
                    {item.year ?? '年份不详'}
                  </span>
                  <p class="mt-1.5 font-display text-[1.05rem] leading-snug text-ink">{item.name}</p>
                  <p class="mt-2 text-[11.5px] leading-5 text-ink-soft">{item.description}</p>
                </div>
                {/* 木质隔板 */}
                <div
                  class="relative mt-1.5 h-2.5 w-full border border-ink/50"
                  style="background:linear-gradient(180deg, #c39a6b 0%, #a87c4f 55%, #8a6440 100%);"
                  aria-hidden="true"
                >
                  <span class="absolute inset-x-1.5 top-0.5 h-px bg-cream/40"></span>
                </div>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="py-10 text-center font-mono text-[10px] tracking-[0.2em] text-ink-faint">这一排货架空了</p>
      )
    }
  </div>
</section>
