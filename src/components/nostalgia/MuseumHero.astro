---
/**
 * 老物件馆首屏：夜间展厅 + 玻璃展柜 + 展签。
 * 展柜里的封面使用共享 CoverArt 程序化生成，不依赖外部图片。
 */
import CoverArt from '../shared/CoverArt.astro';
import type { NostalgiaItem } from '../../types';

interface Props {
  itemCount: number;
  categoryCount: number;
  groupCount: number;
  extraCount: number;
  categories: string[];
  featured?: NostalgiaItem;
  sampleNames: string[];
}

const {
  itemCount,
  categoryCount,
  groupCount,
  extraCount,
  categories,
  featured,
  sampleNames,
} = Astro.props;

const hallName = '记忆博物馆';
const stats = [
  { value: String(itemCount), label: '馆藏展品', en: 'OBJECTS' },
  { value: String(categoryCount), label: '门类', en: 'CATEGORIES' },
  { value: String(groupCount), label: '外厅陈列', en: 'WINGS' },
];
const marqueeNames = sampleNames.length ? sampleNames : ['暂无展品'];
const marqueeHalf = [...marqueeNames, ...marqueeNames];
---
<section class="relative overflow-hidden bg-night text-cream">
  <!-- 展厅灯光 -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.06] line-grid" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 left-[10%] h-[30rem] w-[26rem] rounded-full bg-mustard/20 blur-[130px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -bottom-48 right-[6%] h-[28rem] w-[30rem] rounded-full bg-vermilion/15 blur-[140px]" aria-hidden="true"></div>

  <!-- 展厅门楣 -->
  <div
    class="relative mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 border-b border-cream/15 px-4 py-3.5 font-mono text-[9px] tracking-[0.28em] text-cream/45 sm:px-6 sm:text-[10px] lg:px-8"
  >
    <span>HALL 05 / MEMORY MUSEUM</span>
    <span class="hidden sm:inline">ADMISSION FREE · 1980—2009</span>
    <span class="flex items-center gap-2 text-cream/60">
      <span class="h-1.5 w-1.5 rounded-full bg-jade-soft"></span>
      NOW OPEN
    </span>
  </div>

  <div
    class="relative mx-auto grid max-w-7xl gap-14 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[1.06fr_0.94fr] lg:items-center lg:gap-10 lg:px-8"
  >
    <!-- 左：展馆说明 -->
    <div class="relative">
      <p class="label-mono text-mustard">05 · {hallName}</p>
      <h1
        class="mt-5 font-display text-[clamp(2.6rem,6.4vw,4.4rem)] leading-[1.02] tracking-tight text-cream text-balance"
      >
        <span class="whitespace-nowrap">老物件</span><span class="relative inline-block"><span class="relative z-10">馆</span><span class="absolute -inset-x-2 bottom-1 z-0 h-3 bg-vermilion/70" aria-hidden="true"></span></span>
      </h1>
      <p class="mt-4 font-display text-[clamp(1.05rem,2.4vw,1.5rem)] leading-relaxed text-cream/75">
        手上还留着温度的东西
      </p>
      <p class="mt-6 max-w-xl text-[15px] leading-8 text-cream/55 text-pretty">
        这里没有文物，只有被用旧的东西：木陀螺、溜溜球、万能充、小霸王。每一件都按展品登记——
        哪年流行、叫什么别名、怎么玩、谁在什么场合用过。可以凑近看，但不能带走。
      </p>

      <!-- 馆藏统计 -->
      <dl class="mt-9 grid max-w-lg grid-cols-3 border-y border-cream/15">
        {
          stats.map((stat, index) => (
            <div
              class:list={[
                'px-4 py-4 first:pl-0',
                index === stats.length - 1 ? '' : 'border-r border-cream/15',
              ]}
            >
              <dt class="font-mono text-[9px] tracking-[0.24em] text-cream/40">{stat.en}</dt>
              <dd class="mt-1 flex items-baseline gap-1.5">
                <span class="font-display text-3xl leading-none text-cream">{stat.value}</span>
                <span class="text-[11px] text-cream/50">{stat.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#exhibits" class="btn-retro">进入展厅</a>
        <a
          href="#extras"
          class="inline-flex items-center gap-2 border-b border-cream/30 pb-1 font-mono text-[11px] tracking-[0.16em] text-cream/60 transition-colors hover:border-mustard hover:text-mustard"
        >
          去后厅 · 小卖部与广告墙
          <span aria-hidden="true">↓</span>
        </a>
      </div>

      <p class="mt-7 max-w-md text-[11px] leading-6 text-cream/35">
        参观提示：展签可以点开，玩法说明写在背面；馆内共有 {extraCount} 件后厅藏品。
        {categories.length > 0 && <span class="text-cream/50">门类：{categories.join(' / ')}</span>}
      </p>
    </div>

    <!-- 右：玻璃展柜 -->
    <div class="relative mx-auto w-full max-w-sm lg:mr-0">
      {
        featured ? (
          <div class="relative">
            <!-- 射灯 -->
            <div
              class="pointer-events-none absolute -top-16 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-mustard/25 blur-3xl"
              aria-hidden="true"
            />
            <span class="stamp absolute -left-3 top-8 z-20 bg-night text-mustard">馆藏精选</span>

            <!-- 柜体 -->
            <div class="relative border-[1.5px] border-cream/25 bg-cream/[0.045] p-3">
              <span class="absolute left-2 top-2 h-2.5 w-2.5 border-l border-t border-cream/60" aria-hidden="true" />
              <span class="absolute right-2 top-2 h-2.5 w-2.5 border-r border-t border-cream/60" aria-hidden="true" />
              <span class="absolute bottom-2 left-2 h-2.5 w-2.5 border-b border-l border-cream/60" aria-hidden="true" />
              <span class="absolute bottom-2 right-2 h-2.5 w-2.5 border-b border-r border-cream/60" aria-hidden="true" />

              <div class="relative overflow-hidden border border-cream/15">
                <CoverArt
                  title={featured.name}
                  subtitle={featured.aliases?.[0] ?? featured.category}
                  year={featured.yearStart}
                  kind="toy"
                />
                <span
                  class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-cream/15 to-transparent"
                  aria-hidden="true"
                />
              </div>

              <div
                class="mt-3 flex items-center justify-between font-mono text-[9px] tracking-[0.22em] text-cream/45"
              >
                <span>EXHIBIT NO. 01</span>
                <span>{featured.category} · {featured.yearStart}</span>
              </div>
            </div>

            <!-- 展柜底座 -->
            <div class="mx-auto h-3 w-[94%] border-x border-b border-cream/20 bg-night-soft" aria-hidden="true"></div>

            <!-- 展签 -->
            <div class="relative mx-auto mt-4 w-[92%] border-[1.5px] border-ink bg-cream p-4 text-ink shadow-print">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-display text-xl leading-tight">{featured.name}</p>
                  {featured.aliases && featured.aliases.length > 0 && (
                    <p class="mt-1 truncate font-mono text-[9px] tracking-[0.14em] text-ink-faint">
                      又名 {featured.aliases.join(' / ')}
                    </p>
                  )}
                </div>
                <span class="stamp shrink-0 text-vermilion">{featured.category}</span>
              </div>
              <p class="mt-2.5 line-clamp-3 text-xs leading-6 text-ink-soft">
                {featured.memory ?? featured.description}
              </p>
              <div class="mt-3 flex items-center justify-between border-t border-dashed border-ink/20 pt-2 font-mono text-[8px] tracking-[0.18em] text-ink-faint">
                <span>{featured.yearStart}—{featured.yearEnd ?? '?'}</span>
                <span>藏品编号 01</span>
              </div>
            </div>
          </div>
        ) : (
          <div class="border border-dashed border-cream/25 px-6 py-16 text-center">
            <p class="font-display text-xl text-cream/70">展柜暂时是空的</p>
            <p class="mt-2 font-mono text-[10px] tracking-[0.2em] text-cream/35">COLLECTION EMPTY</p>
          </div>
        )
      }
    </div>
  </div>

  <!-- 滚动展品名单 -->
  <div class="relative overflow-hidden border-t border-cream/10 py-3" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <span class="flex shrink-0 items-center gap-6 pr-6 font-mono text-[9px] tracking-[0.28em] text-cream/30">
            {marqueeHalf.map((name) => (
              <>
                <span>{name}</span>
                <span class="text-mustard/60">·</span>
              </>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</section>
