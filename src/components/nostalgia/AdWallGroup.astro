---
/**
 * 后厅陈列之三：广告墙。
 * 报纸剪贴 / 手写广告单的拼贴排版，用 CSS columns 做自然的错落感。
 */
import type { ExtraGroup } from '../../types';
import { layoutLabels } from './museum';

interface Props {
  group: ExtraGroup;
  index: number;
}

const { group, index } = Astro.props;
const no = String(index + 1).padStart(2, '0');
const rotations = [
  'rotate-[-1.4deg]',
  'rotate-[1deg]',
  'rotate-[-0.5deg]',
  'rotate-[1.5deg]',
  'rotate-[-1deg]',
  'rotate-[0.6deg]',
];
const papers = ['bg-paper', 'bg-cream', 'bg-paper-deep'];
---
<section class="relative overflow-hidden border-[1.5px] border-ink bg-cream shadow-print">
  <div class="pointer-events-none absolute inset-0 opacity-25 dot-grid" aria-hidden="true"></div>

  <div class="relative flex flex-wrap items-start justify-between gap-3 border-b-[1.5px] border-ink bg-ink px-5 py-4 text-cream sm:px-6">
    <div class="min-w-0">
      <p class="font-mono text-[9px] tracking-[0.26em] text-mustard">
        外厅 {no} / {layoutLabels.ad.en}
      </p>
      <h3 class="mt-1.5 font-display text-2xl leading-tight text-cream sm:text-[1.8rem]">{group.title}</h3>
      <p class="mt-1.5 max-w-2xl text-[13px] leading-6 text-cream/50">{group.subtitle}</p>
    </div>
    <span class="stamp shrink-0 text-mustard">广告墙</span>
  </div>

  <div class="relative p-4 sm:p-6">
    {
      group.items.length > 0 ? (
        <div class="columns-1 gap-4 sm:columns-2 sm:gap-5 lg:columns-3">
          {group.items.map((item, itemIndex) => (
            <figure
              class:list={[
                'relative mb-4 break-inside-avoid border-[1.5px] border-ink p-4 shadow-print-sm transition-shadow duration-300 hover:shadow-print sm:mb-5',
                rotations[itemIndex % rotations.length],
                papers[itemIndex % papers.length],
              ]}
            >
              {/* 胶带 */}
              <span
                class="absolute -top-2 left-1/2 h-4 w-14 -translate-x-1/2 -rotate-2 border border-ink/15 bg-mustard/50"
                aria-hidden="true"
              ></span>

              <div class="flex items-center justify-between gap-3 border-b border-ink/20 pb-2 font-mono text-[8px] tracking-[0.22em] text-ink-faint">
                <span>ADVERTISEMENT</span>
                <span>{item.year ?? '——'}</span>
              </div>

              <p class="mt-3 font-display text-[clamp(1.1rem,2.6vw,1.45rem)] leading-snug text-ink text-balance">
                {item.name}
              </p>
              <p class="mt-2 text-[12px] leading-6 text-ink-soft">{item.description}</p>

              <div class="mt-3.5 flex items-center justify-between gap-2">
                {item.tag ? <span class="stamp text-vermilion">{item.tag}</span> : <span aria-hidden="true"></span>}
                <span class="font-mono text-[8px] tracking-[0.2em] text-ink-faint">
                  NO. {String(itemIndex + 1).padStart(2, '0')}
                </span>
              </div>
            </figure>
          ))}
        </div>
      ) : (
        <p class="py-10 text-center font-mono text-[10px] tracking-[0.2em] text-ink-faint">这面墙还空着</p>
      )
    }
  </div>
</section>
