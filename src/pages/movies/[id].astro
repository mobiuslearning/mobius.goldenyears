---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/shared/SectionHeader.astro';
import Reveal from '../../components/shared/Reveal.astro';
import CoverArt from '../../components/shared/CoverArt.astro';
import { movies } from '../../data/culture/movies';
import { eventsForYear } from '../../data/events/index';
import { imagesFor } from '../../data/images';
import { eraOfYear } from '../../lib/theme';
import type { ImageCredit, Movie } from '../../types';

export function getStaticPaths() {
  return movies.map((movie) => ({ params: { id: movie.id }, props: { movie } }));
}

interface Props {
  movie: Movie;
}

const { movie } = Astro.props;

const total = movies.length;
const ordered = [...movies].sort(
  (a, b) => a.year - b.year || a.title.localeCompare(b.title, 'zh-Hans-CN'),
);
const position = ordered.findIndex((item) => item.id === movie.id);
const prevMovie = position > 0 ? ordered[position - 1] : undefined;
const nextMovie = position >= 0 && position < ordered.length - 1 ? ordered[position + 1] : undefined;

const era = eraOfYear(movie.year);
const tapeNo = String(position + 1).padStart(2, '0');
const showtimes = ['19:30', '21:40', '23:50'];
const halls = ['1 号厅', '2 号厅', '3 号厅'];
const showtime = showtimes[position % showtimes.length];
const hall = halls[position % halls.length];

const leadSentence = (() => {
  const stop = movie.description.indexOf('。');
  const first = stop >= 0 ? movie.description.slice(0, stop + 1) : movie.description;
  return first.length > 88 ? `${first.slice(0, 86)}……` : first;
})();

const storyParagraphs = (movie.story ?? '')
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
const useDropCap = /[\u3400-\u9fff]/.test(storyParagraphs[0]?.charAt(0) ?? '');

const gallery: ImageCredit[] = Array.from(
  new Map(
    [...(movie.gallery ?? []), ...imagesFor(movie.id)].map((image) => [image.src, image] as const),
  ).values(),
);

const yearEvents = eventsForYear(movie.year).slice(0, 4);

const related = movies
  .filter((item) => item.id !== movie.id)
  .map((item) => ({
    movie: item,
    score:
      (item.type === movie.type ? 4 : 0) +
      (item.region === movie.region ? 2 : 0) +
      (eraOfYear(item.year) === era ? 1 : 0) -
      Math.min(3, Math.abs(item.year - movie.year) / 10),
  }))
  .sort((a, b) => b.score - a.score || a.movie.year - b.movie.year)
  .slice(0, 4)
  .map((entry) => entry.movie);

const metaDescription = `${movie.title}（${movie.year}，${movie.type}，${movie.region}）：${movie.description.slice(0, 90)}`;
---

<BaseLayout title={`${movie.title} · ${movie.year}`} description={metaDescription}>
  <!-- ============================ Hero：录像厅档案 ============================ -->
  <section class="relative overflow-hidden border-b-[1.5px] border-ink bg-night text-cream scanlines">
    <div class="film-perf absolute inset-x-0 top-0 z-10 h-4 border-b border-cream/10" aria-hidden="true"></div>
    <div class="film-perf absolute inset-x-0 bottom-0 z-10 h-4 border-t border-cream/10" aria-hidden="true"></div>
    <div class="film-perf-y absolute inset-y-4 left-0 z-10 hidden w-2.5 border-r border-cream/10 lg:block" aria-hidden="true"></div>
    <div class="film-perf-y absolute inset-y-4 right-0 z-10 hidden w-2.5 border-l border-cream/10 lg:block" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_25%_-10%,rgba(194,59,42,0.2),transparent_55%)]"
      aria-hidden="true"
    ></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.05] line-grid" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 pb-14 pt-10 sm:px-6 sm:pb-16 sm:pt-12 lg:px-8">
      <nav class="font-mono text-[10px] tracking-[0.18em] text-cream/40" aria-label="面包屑">
        <a href="/" class="transition-colors hover:text-cream">首页</a>
        <span class="mx-2 text-cream/20" aria-hidden="true">/</span>
        <a href="/movies/" class="transition-colors hover:text-cream">影视</a>
        <span class="mx-2 text-cream/20" aria-hidden="true">/</span>
        <span class="text-cream/60">影片档案</span>
      </nav>

      <div class="mt-8 grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <Reveal direction="scale" class="relative">
          <div class="relative mx-auto w-full max-w-[320px]">
            <div class="relative border-[1.5px] border-cream/30 bg-night-soft p-2 shadow-[10px_10px_0_rgba(0,0,0,0.45)]">
              <CoverArt
                title={movie.title}
                year={movie.year}
                kind="movie"
                label="FILM"
                seed={`detail-${movie.id}`}
                image={movie.image}
              />
              {
                movie.featured && (
                  <span class="pointer-events-none absolute -right-2 -top-3 z-20 rotate-3 border-[1.5px] border-mustard bg-mustard px-1.5 py-0.5 font-mono text-[8px] font-bold tracking-[0.16em] text-ink">
                    本周放映
                  </span>
                )
              }
              <span class="pointer-events-none absolute -bottom-2 -right-1 z-20 rotate-1 border border-cream/30 bg-ink px-1.5 py-0.5 font-mono text-[8px] tracking-[0.12em] text-cream/60">
                VHS {tapeNo}
              </span>
            </div>
            <p class="mt-4 text-center font-mono text-[9px] uppercase tracking-[0.2em] text-cream/30">
              Golden Years Video Club · Tape {tapeNo}
            </p>
          </div>
        </Reveal>

        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-[11px] font-bold tracking-[0.3em] text-mustard">
              FILM {String(position + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}
            </span>
            <span class="h-px w-10 bg-cream/30" aria-hidden="true"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-cream/40">
              {movie.type} · {movie.region}
            </span>
          </div>

          <h1 class="mt-4 font-display text-[clamp(2.4rem,6vw,4.2rem)] leading-[1.05] tracking-tight text-cream">
            {movie.title}
          </h1>

          <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] tracking-[0.16em] text-cream/50">
            <span>{movie.year}</span>
            <span class="text-cream/20" aria-hidden="true">/</span>
            <span>{movie.type}</span>
            <span class="text-cream/20" aria-hidden="true">/</span>
            <span>{movie.region}</span>
            <span class="text-cream/20" aria-hidden="true">/</span>
            <span>{movie.genre}</span>
          </div>

          <dl class="mt-5 grid max-w-xl gap-x-8 gap-y-2 text-[13px] leading-7 text-cream/65 sm:grid-cols-2">
            {
              movie.director && (
                <div class="flex gap-2">
                  <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-cream/35">导演</dt>
                  <dd>{movie.director}</dd>
                </div>
              )
            }
            {
              movie.cast && (
                <div class="flex gap-2 sm:col-span-2">
                  <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-cream/35">主演</dt>
                  <dd>{movie.cast}</dd>
                </div>
              )
            }
          </dl>

          {leadSentence && (
            <p class="mt-5 max-w-xl border-l-2 border-vermilion pl-4 font-display text-lg italic leading-8 text-cream/75">
              {leadSentence}
            </p>
          )}

          {
            movie.themeSong && (
              <div class="mt-6 inline-flex max-w-full items-center gap-3 border-[1.5px] border-cream/25 bg-cream/[0.04] px-3 py-2">
                <span class="flex shrink-0 items-center gap-1" aria-hidden="true">
                  <span class="relative grid h-4 w-4 place-items-center rounded-full border border-mustard/70">
                    <span class="h-1 w-1 rounded-full bg-mustard/80" />
                  </span>
                  <span class="relative grid h-4 w-4 place-items-center rounded-full border border-mustard/70">
                    <span class="h-1 w-1 rounded-full bg-mustard/80" />
                  </span>
                </span>
                <span class="shrink-0 font-mono text-[9px] tracking-[0.18em] text-mustard">A 面 · 主题曲</span>
                <span class="truncate font-display text-sm text-cream/85">
                  {movie.themeSong.title}
                  <span class="ml-1 font-mono text-[9px] text-cream/45">{movie.themeSong.artist}</span>
                </span>
              </div>
            )
          }

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/movies/" class="btn-retro">← 返回片库</a>
            <a href={`/timeline/${movie.year}/`} class="btn-retro btn-retro-solid">打开 {movie.year} 年 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ 正文 ============================ -->
  <section class="relative py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[1.45fr_0.55fr]">
        <div>
          <Reveal>
            <p class="label-mono text-vermilion">剧情简介 · Synopsis</p>
            <p class="mt-4 max-w-2xl text-[16px] leading-9 text-ink-soft text-pretty">{movie.description}</p>
          </Reveal>

          {
            movie.quote && (
              <Reveal delay={60}>
                <figure
                  class="relative mt-10 overflow-hidden border-[1.5px] border-ink bg-cream px-6 py-7 shadow-print sm:px-10"
                  style="background-image:repeating-linear-gradient(rgba(34,28,22,0.07) 0 1px, transparent 1px 36px)"
                >
                  <div class="pointer-events-none absolute -right-2 -top-4 select-none font-display text-8xl leading-none text-vermilion/10" aria-hidden="true">
                    “
                  </div>
                  <p class="label-mono relative text-vermilion">经典台词 · Quote</p>
                  <blockquote class="relative mt-4 font-display text-[clamp(1.3rem,2.6vw,1.8rem)] italic leading-[1.7] text-ink">
                    「{movie.quote}」
                  </blockquote>
                  <figcaption class="relative mt-4 text-right font-mono text-[10px] tracking-[0.16em] text-ink-faint">
                    —— 《{movie.title}》
                  </figcaption>
                </figure>
              </Reveal>
            )
          }

          {
            storyParagraphs.length > 0 && (
              <Reveal delay={80}>
                <div class="mt-12">
                  <p class="label-mono text-jade">观影记忆 · Viewing Notes</p>
                  <div class="mt-4 max-w-2xl space-y-5">
                    {storyParagraphs.map((paragraph, index) => (
                      <p
                        class:list={[
                          'text-[15px] leading-9 text-ink-soft text-pretty',
                          index === 0 &&
                            useDropCap &&
                            'first-letter:float-left first-letter:mr-2 first-letter:font-display first-letter:text-[3.2rem] first-letter:leading-[0.85] first-letter:text-vermilion',
                        ]}
                      >
                        {paragraph}
                      </p>
                    ))}
                  </div>
                </div>
              </Reveal>
            )
          }

          {
            gallery.length > 0 && (
              <Reveal delay={90}>
                <div class="mt-12">
                  <p class="label-mono text-vermilion">图片 · Gallery</p>
                  <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    {gallery.map((image) => (
                      <figure class="border-[1.5px] border-ink bg-cream p-2 shadow-print-sm">
                        <img
                          src={image.src}
                          alt={image.alt}
                          loading="lazy"
                          decoding="async"
                          class="aspect-[4/3] w-full object-cover"
                        />
                        <figcaption class="mt-2 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 font-mono text-[9px] leading-5 text-ink-faint">
                          <span class="line-clamp-1">{image.title ?? image.alt}</span>
                          <span>{image.author ?? '佚名'}{image.license ? ` · ${image.license}` : ''}</span>
                        </figcaption>
                        {image.sourceUrl && (
                          <a
                            href={image.sourceUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-1 inline-block font-mono text-[9px] text-vermilion underline decoration-vermilion/40 underline-offset-2"
                          >
                            查看来源
                          </a>
                        )}
                      </figure>
                    ))}
                  </div>
                </div>
              </Reveal>
            )
          }
        </div>

        <!-- 侧栏：放映档案 -->
        <aside class="lg:pt-2">
          <div class="space-y-6 lg:sticky lg:top-24">
            <Reveal>
              <div class="border-[1.5px] border-ink bg-cream p-5 shadow-print">
                <div class="flex items-center justify-between border-b border-ink/15 pb-3">
                  <p class="label-mono text-vermilion">放映档案</p>
                  <span class="font-mono text-[9px] tracking-[0.1em] text-ink-faint">VHS {tapeNo}</span>
                </div>
                <dl class="mt-4 space-y-3 text-sm">
                  <div class="flex items-baseline justify-between gap-3 border-b border-ink/10 pb-2">
                    <dt class="font-mono text-[9px] tracking-[0.16em] text-ink-faint">类型</dt>
                    <dd class="text-right text-ink">{movie.type}</dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-3 border-b border-ink/10 pb-2">
                    <dt class="font-mono text-[9px] tracking-[0.16em] text-ink-faint">地区</dt>
                    <dd class="text-right text-ink">{movie.region}</dd>
                  </div>
                  {
                    movie.director && (
                      <div class="flex items-baseline justify-between gap-3 border-b border-ink/10 pb-2">
                        <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-ink-faint">导演</dt>
                        <dd class="text-right text-ink">{movie.director}</dd>
                      </div>
                    )
                  }
                  {
                    movie.cast && (
                      <div class="flex items-baseline justify-between gap-3 border-b border-ink/10 pb-2">
                        <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-ink-faint">主演</dt>
                        <dd class="text-right text-[13px] leading-6 text-ink">{movie.cast}</dd>
                      </div>
                    )
                  }
                  <div class="flex items-baseline justify-between gap-3 border-b border-ink/10 pb-2">
                    <dt class="font-mono text-[9px] tracking-[0.16em] text-ink-faint">年份</dt>
                    <dd class="text-right font-mono text-ink">{movie.year}</dd>
                  </div>
                  {
                    movie.themeSong && (
                      <div class="flex items-baseline justify-between gap-3">
                        <dt class="shrink-0 font-mono text-[9px] tracking-[0.16em] text-ink-faint">主题曲</dt>
                        <dd class="text-right text-[13px] leading-6 text-ink">
                          {movie.themeSong.title}
                          <span class="ml-1 font-mono text-[9px] text-ink-faint">{movie.themeSong.artist}</span>
                        </dd>
                      </div>
                    )
                  }
                </dl>
              </div>
            </Reveal>

            <Reveal delay={60}>
              <div class="ticket bg-cream p-4 text-ink shadow-print-sm">
                <div class="flex items-center justify-between gap-3">
                  <p class="font-mono text-[8px] tracking-[0.22em] text-ink-faint">ADMIT ONE · 录像厅</p>
                  <p class="font-mono text-[9px] tracking-[0.14em] text-ink-soft">¥3.00</p>
                </div>
                <p class="mt-2 truncate font-display text-xl leading-tight">{movie.title}</p>
                <div class="mt-2 flex items-center justify-between font-mono text-[9px] leading-5 text-ink-soft">
                  <span>{showtime} · {hall}</span>
                  <span>不对号入座</span>
                </div>
                <p class="mt-1 font-mono text-[8px] tracking-[0.16em] text-ink-faint">夜场连映两片 · 冷气开放</p>
              </div>
            </Reveal>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============================ 那一年 ============================ -->
  <section class="border-y-[1.5px] border-ink bg-paper-deep/60 py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHeader
          index={String(movie.year)}
          eyebrow="That Year"
          title={`那一年，${movie.year}`}
          description={yearEvents.length > 0 ? '这部电影上映的年份里，还发生过这些事。' : '这一年的档案还在整理，去完整时光轴看看。'}
          accent="sky"
        />
        <Reveal class="shrink-0">
          <a href={`/timeline/${movie.year}/`} class="btn-retro">打开 {movie.year} 年 →</a>
        </Reveal>
      </div>

      {
        yearEvents.length > 0 ? (
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {yearEvents.map((event, index) => (
              <Reveal delay={index * 60}>
                <article class="h-full border-[1.5px] border-ink bg-cream p-4 shadow-print-sm">
                  <div class="flex flex-wrap items-center gap-2 font-mono text-[9px] tracking-[0.16em]">
                    <span
                      class:list={['inline-block h-2 w-2 rounded-full', event.scope === 'china' ? 'bg-vermilion' : 'bg-sky']}
                      aria-hidden="true"
                    />
                    <span class="text-ink-faint">{event.scope === 'china' ? '中国' : '世界'}</span>
                    <span class="text-ink/25" aria-hidden="true">/</span>
                    <span class="text-jade">{event.category}</span>
                    {event.highlight && <span class="stamp ml-auto text-vermilion">年度大事件</span>}
                  </div>
                  <h3 class="mt-2 font-display text-lg leading-snug text-ink">{event.title}</h3>
                  <p class="mt-2 line-clamp-3 text-[13px] leading-6 text-ink-soft">{event.description}</p>
                </article>
              </Reveal>
            ))}
          </div>
        ) : (
          <div class="mt-8 border-[1.5px] border-dashed border-ink/30 bg-cream/50 px-6 py-10 text-center">
            <p class="font-display text-xl text-ink-soft">这一年的档案还在整理</p>
            <p class="mx-auto mt-2 max-w-md text-sm leading-7 text-ink-faint">先去完整时光轴，按年份翻一翻。</p>
            <a href="/timeline/" class="btn-retro mt-5">去时光轴 →</a>
          </div>
        )
      }
    </div>
  </section>

  <!-- ============================ 同年代片单 ============================ -->
  {
    related.length > 0 && (
      <section class="relative overflow-hidden border-b-[1.5px] border-cream/10 bg-night py-14 text-cream sm:py-20">
    <div class="film-perf absolute inset-x-0 top-0 h-4 border-b border-cream/10" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_75%_0%,rgba(209,156,55,0.12),transparent_55%)]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[11px] font-bold tracking-[0.3em] text-mustard">ALSO SHOWING</span>
            <span class="h-px w-10 bg-cream/30" aria-hidden="true"></span>
          </div>
          <h2 class="mt-3 font-display text-[clamp(1.9rem,4.5vw,3rem)] leading-[1.15] text-cream">同年代片单</h2>
          <div class="mt-4 flex items-center gap-2" aria-hidden="true">
            <span class="h-[3px] w-12 bg-mustard"></span>
            <span class="h-[3px] w-3 bg-cream/40"></span>
          </div>
        </div>
        <a
          href="/movies/"
          class="inline-flex items-center gap-2 border-b border-cream/30 pb-0.5 font-mono text-[10px] tracking-[0.18em] text-cream/50 transition-colors hover:border-mustard hover:text-mustard"
        >
          回到片库 <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-8 grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
        {
          related.map((item, index) => (
            <Reveal delay={index * 60}>
              <a
                href={`/movies/${item.id}/`}
                class="group flex h-full flex-col border border-cream/20 bg-night-soft p-2 transition-[transform,border-color] duration-300 hover:-translate-y-1 hover:border-mustard/70"
              >
                <CoverArt
                  title={item.title}
                  year={item.year}
                  kind="movie"
                  label="FILM"
                  seed={`related-${item.id}`}
                />
                <p class="mt-2.5 line-clamp-1 font-display text-sm text-cream transition-colors group-hover:text-mustard">
                  {item.title}
                </p>
                <p class="mt-auto pt-1 font-mono text-[9px] tracking-[0.1em] text-cream/40">
                  {item.year} · {item.type} · {item.region}
                </p>
              </a>
            </Reveal>
          ))
        }
      </div>
    </div>
      </section>
    )
  }

  <!-- ============================ 上一部 / 下一部 ============================ -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid gap-3 sm:grid-cols-2">
      {
        prevMovie ? (
          <a
            href={`/movies/${prevMovie.id}/`}
            class="group flex items-center gap-4 border-[1.5px] border-ink bg-cream p-4 shadow-print-sm transition-transform hover:-translate-y-0.5"
          >
            <span class="shrink-0 font-mono text-[10px] tracking-[0.16em] text-ink-faint">← 上一部</span>
            <span class="ml-auto min-w-0 text-right">
              <span class="block truncate font-display text-base text-ink transition-colors group-hover:text-vermilion">
                {prevMovie.title}
              </span>
              <span class="mt-0.5 block font-mono text-[9px] text-ink-faint">
                {prevMovie.director ?? prevMovie.type} · {prevMovie.year}
              </span>
            </span>
          </a>
        ) : (
          <div class="flex items-center gap-3 border border-dashed border-ink/25 p-4 font-mono text-[10px] tracking-[0.14em] text-ink-faint">
            ← 已经是第一部
          </div>
        )
      }
      {
        nextMovie ? (
          <a
            href={`/movies/${nextMovie.id}/`}
            class="group flex flex-row-reverse items-center gap-4 border-[1.5px] border-ink bg-cream p-4 text-right shadow-print-sm transition-transform hover:-translate-y-0.5"
          >
            <span class="shrink-0 font-mono text-[10px] tracking-[0.16em] text-ink-faint">下一部 →</span>
            <span class="mr-auto min-w-0 text-left">
              <span class="block truncate font-display text-base text-ink transition-colors group-hover:text-vermilion">
                {nextMovie.title}
              </span>
              <span class="mt-0.5 block font-mono text-[9px] text-ink-faint">
                {nextMovie.director ?? nextMovie.type} · {nextMovie.year}
              </span>
            </span>
          </a>
        ) : (
          <div class="flex flex-row-reverse items-center gap-3 border border-dashed border-ink/25 p-4 text-right font-mono text-[10px] tracking-[0.14em] text-ink-faint">
            已经是最后一部 →
          </div>
        )
      }
    </div>

    <div class="mt-10 text-center">
      <a href="/movies/" class="btn-retro">← 回到海报墙</a>
    </div>
  </section>
</BaseLayout>

