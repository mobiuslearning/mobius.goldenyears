---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const links = [
  { label: '回到首页', href: '/' },
  { label: '打开时光轴', href: '/timeline/' },
  { label: '启动时光机', href: '/time-machine/' },
];
---

<BaseLayout title="信号丢失 404" description="这一页的录像带好像被洗掉了。" noindex>
  <section class="relative flex min-h-[75svh] items-center overflow-hidden bg-night py-20 text-cream">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07] line-grid"></div>
    <div class="scanlines pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="grain pointer-events-none absolute inset-0 opacity-40"></div>
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[36rem] w-[36rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[radial-gradient(circle,rgba(209,156,55,0.14),transparent_65%)]"></div>

    <div class="relative mx-auto w-full max-w-4xl px-4 text-center sm:px-6">
      <p class="font-mono text-[10px] tracking-[0.34em] text-mustard">NO SIGNAL · 无信号</p>

      <div class="mt-8 flex items-center justify-center gap-4 font-display leading-none">
        <span class="text-[clamp(4rem,14vw,9rem)] text-stroke-cream">4</span>
        <span class="grid h-[clamp(4rem,14vw,9rem)] w-[clamp(4rem,14vw,9rem)] place-items-center rounded-full border-[3px] border-cream/30 bg-vermilion text-[clamp(2rem,7vw,4.5rem)] text-cream shadow-[0_0_60px_rgba(194,59,42,0.35)]">
          0
        </span>
        <span class="text-[clamp(4rem,14vw,9rem)] text-stroke-cream">4</span>
      </div>

      <h1 class="mt-8 font-display text-[clamp(1.6rem,4vw,2.6rem)]">这盘带子，好像被洗掉了</h1>
      <p class="mx-auto mt-4 max-w-md text-sm leading-7 text-cream/55">
        你找的页面不在档案里。可能是链接写错了，也可能是那一段记忆，暂时还没被收录。
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        {
          links.map((link, index) => (
            <a href={link.href} class:list={['btn-retro', index === 0 ? 'border-mustard bg-mustard text-ink hover:bg-cream' : 'border-cream/50 bg-transparent text-cream hover:bg-cream hover:text-ink']}>
              {link.label}
            </a>
          ))
        }
      </div>

      <p class="mt-12 font-mono text-[9px] tracking-[0.24em] text-cream/25">
        {site.title} · ERROR CODE 404 · PLEASE REWIND
      </p>
    </div>
  </section>
</BaseLayout>
