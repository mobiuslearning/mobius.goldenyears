---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import Reveal from '../components/shared/Reveal.astro';
import MuseumHero from '../components/nostalgia/MuseumHero.astro';
import ExhibitFilters from '../components/nostalgia/ExhibitFilters.astro';
import ExhibitCard from '../components/nostalgia/ExhibitCard.astro';
import ExtraGroup from '../components/nostalgia/ExtraGroup.astro';
import { eraOfYear } from '../components/nostalgia/museum';
import { toys } from '../data/nostalgia/toys';
import { extraGroups } from '../data/nostalgia/extras';
import { eras, sections } from '../data/site';
import type { NostalgiaCategory } from '../types';

const categoryOrder: NostalgiaCategory[] = ['玩具', '游戏', '物件', '零食', '影音', '数码', '校园'];
const presentCategories = [...new Set(toys.map((item) => item.category))];
const categories = categoryOrder
  .filter((category) => presentCategories.includes(category))
  .concat(presentCategories.filter((category) => !categoryOrder.includes(category)))
  .map((value) => ({
    value,
    count: toys.filter((item) => item.category === value).length,
  }));

const eraFilters = eras
  .map((era) => ({
    value: era.id as string,
    label: era.label,
    count: toys.filter((item) => eraOfYear(item.yearStart) === era.id).length,
  }))
  .filter((era) => era.count > 0);

const featured = toys.find((item) => item.featured) ?? toys[0];
const extraCount = extraGroups.reduce((total, group) => total + group.items.length, 0);
const otherSections = [
  ...sections.filter((section) => section.href !== '/toys/'),
  {
    href: '/about/',
    index: '07',
    title: '关于',
    en: 'About',
    description: '站点缘起、数据与版权声明、技术栈和更新日志。',
    accent: 'vermilion',
  },
];
---
<BaseLayout
  title="老物件"
  description="记忆博物馆：打陀螺、溜溜球、万能充电器、小霸王……按展品陈列，附别名、流行年份、玩法说明与私人记忆；后厅还有小卖部货架、动画片节目单和广告墙。"
>
  <MuseumHero
    itemCount={toys.length}
    categoryCount={categories.length}
    groupCount={extraGroups.length}
    extraCount={extraCount}
    categories={presentCategories}
    featured={featured}
    sampleNames={toys.map((item) => item.name)}
  />

  <!-- 展柜 / 展品 -->
  <section id="exhibits" class="relative scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Reveal>
        <SectionHeader
          index="01"
          eyebrow="Exhibit Hall"
          title="按编号陈列的童年"
          description="从 1980 到 2009，每一件都标了叫法、流行年份和玩法。点开展品可以看完整展签；下方的「玩法」可以就地展开，背面写着怎么用。"
        />
      </Reveal>

      <div data-collection class="mt-10">
        <Reveal delay={80}>
          <ExhibitFilters categories={categories} eras={eraFilters} total={toys.length} />
        </Reveal>

        {
          toys.length > 0 ? (
            <div class="mt-8 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
              {toys.map((item, index) => (
                <ExhibitCard item={item} index={index} />
              ))}
            </div>
          ) : (
            <div class="mt-8 border-[1.5px] border-dashed border-ink/30 bg-cream/60 px-6 py-16 text-center">
              <p class="font-display text-xl text-ink">展厅还在布展</p>
              <p class="mt-2 text-sm text-ink-faint">老物件数据正在整理中，稍后再来。</p>
            </div>
          )
        }

        <div
          data-empty
          hidden
          class="mx-auto mt-8 max-w-xl border-[1.5px] border-dashed border-ink/30 bg-cream/60 px-6 py-14 text-center"
        >
          <p class="font-mono text-[10px] tracking-[0.26em] text-ink-faint">NO MATCH</p>
          <p class="mt-3 font-display text-xl text-ink">这件东西暂时不在馆里</p>
          <p class="mt-2 text-sm leading-6 text-ink-soft">换一个类别，或者把搜索词去掉试试。</p>
        </div>

        <p data-result-status class="sr-only" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- 后厅：三种不同排版 -->
  <section id="extras" class="relative scroll-mt-20 border-y-[1.5px] border-ink/15 bg-paper-deep/50 py-16 sm:py-24">
    <div class="pointer-events-none absolute inset-0 opacity-40 bg-paper-texture" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Reveal>
        <SectionHeader
          index="02"
          eyebrow="Back Hall"
          title="推开后门，是另一间屋子"
          description="展柜之外，童年还有三种样子：小卖部货架上的零食、傍晚电视里的节目单、贴满墙的广告词。三种陈列按分组轮换，没有固定的顺序。"
          accent="jade"
        />
      </Reveal>

      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] tracking-[0.16em] text-ink-faint">
        <span>外厅 {extraGroups.length} 组</span>
        <span class="h-3 w-px bg-ink/20" aria-hidden="true"></span>
        <span>{extraCount} 件藏品</span>
        <span class="h-3 w-px bg-ink/20" aria-hidden="true"></span>
        <span>陈列方式：货架 / 节目单 / 广告墙</span>
      </div>

      {
        extraGroups.length > 0 ? (
          <div class="mt-10 space-y-12 sm:space-y-16">
            {extraGroups.map((group, index) => (
              <Reveal delay={40}>
                <ExtraGroup group={group} index={index} />
              </Reveal>
            ))}
          </div>
        ) : (
          <p class="mt-10 border-[1.5px] border-dashed border-ink/30 bg-cream/60 px-6 py-14 text-center text-sm text-ink-faint">
            后厅正在整理，暂时没有陈列。
          </p>
        )
      }
    </div>
  </section>

  <!-- 结尾引导 -->
  <section id="before-you-leave" class="relative scroll-mt-20 overflow-hidden bg-night text-cream">
    <div class="pointer-events-none absolute inset-0 opacity-[0.05] line-grid" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="label-mono text-mustard">Before You Leave</p>
          <h2 class="mt-3 font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.15] text-cream">
            闭馆之前，再去别的展厅看看
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-7 text-cream/55">
            如果这里有一件东西让你想起某个人，那它在别处也会有回声。
          </p>
        </div>
        <a href="/about/#comments" class="btn-retro shrink-0">在留言板留一句</a>
      </div>

      <ul class="mt-10 grid gap-px border-[1.5px] border-cream/15 bg-cream/15 sm:grid-cols-2 lg:grid-cols-3">
        {
          otherSections.map((section) => (
            <li>
              <a
                href={section.href}
                class="group flex h-full items-baseline justify-between gap-4 bg-night px-5 py-5 transition-colors hover:bg-night-soft"
              >
                <span>
                  <span class="font-mono text-[9px] tracking-[0.3em] text-mustard/70">
                    {section.index} / {section.en}
                  </span>
                  <span class="mt-1.5 block font-display text-xl text-cream">{section.title}</span>
                  <span class="mt-1 block text-[12px] leading-5 text-cream/40">{section.description}</span>
                </span>
                <span
                  class="shrink-0 font-mono text-cream/30 transition-transform group-hover:translate-x-1 group-hover:text-mustard"
                  aria-hidden="true"
                >
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/collection';
  import '../scripts/toys';
</script>
