---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/shared/Reveal.astro';
import PosterCard from '../components/culture/movies/PosterCard.astro';
import FeaturedReel from '../components/culture/movies/FeaturedReel.astro';
import { movies } from '../data/culture/movies';
import { eraOfYear } from '../lib/theme';
import type { MovieType, MusicRegion } from '../types';

const eraOrder = ['1980s', '1990s', '2000s'] as const;
const eras = eraOrder.filter((era) => movies.some((movie) => eraOfYear(movie.year) === era));
const typeOrder: MovieType[] = ['电影', '电视剧', '动画片'];
const types = typeOrder.filter((type) => movies.some((movie) => movie.type === type));
const regionOrder: MusicRegion[] = ['华语', '港台', '欧美', '日韩', '其他'];
const regions = regionOrder.filter((region) => movies.some((movie) => movie.region === region));

const featured = movies.filter((movie) => movie.featured);
const reel = (featured.length ? featured : movies).slice(0, 10);
const showtimes = ['19:30', '21:40', '23:50'];
const showtimeRows = movies.slice(0, 3).map((movie, index) => ({
  time: showtimes[index % showtimes.length],
  movie,
}));
const tickerTitles = (featured.length ? featured : movies).slice(0, 6).map((movie) => movie.title);
const tickerItems = tickerTitles.length
  ? [...tickerTitles, ...tickerTitles]
  : ['今晚放映 · 请稍候', '今晚放映 · 请稍候'];
const tapeTitle = showtimeRows[0]?.movie.title ?? '录像带片单整理中';

const chipClass =
  'border-[1.5px] border-ink/25 bg-cream px-2.5 py-1 font-mono text-[10px] tracking-[0.14em] text-ink-soft transition-colors hover:border-ink';
---

<BaseLayout
  title="影视"
  description="录像厅里的一块钱一场、全家围坐的电视剧、暑假循环播放的动画片：红高粱、霸王别姬、还珠格格、千与千寻，按类型、年代、地区翻这份片单。"
>
  <script>
    import '../scripts/movies';
  </script>

  <!-- ============================ Hero：录像厅 ============================ -->
  <section class="relative overflow-hidden border-b-[1.5px] border-ink bg-night text-cream scanlines">
    <div class="film-perf absolute inset-x-0 top-0 z-10 h-4 border-b border-cream/10" aria-hidden="true"></div>
    <div class="film-perf-y absolute inset-y-4 left-0 z-10 hidden w-2.5 border-r border-cream/10 lg:block" aria-hidden="true"></div>
    <div class="film-perf-y absolute inset-y-4 right-0 z-10 hidden w-2.5 border-l border-cream/10 lg:block" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_-8%,rgba(209,156,55,0.22),transparent_58%)]"
      aria-hidden="true"
    ></div>
    <div class="pointer-events-none absolute inset-0 opacity-[0.06] line-grid" aria-hidden="true"></div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 pb-12 pt-14 sm:px-6 sm:pb-16 sm:pt-16 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-[11px] font-bold tracking-[0.3em] text-mustard">04 / MOVIES</span>
            <span class="h-px w-10 bg-cream/30" aria-hidden="true"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-cream/40">Video Hall</span>
          </div>

          <h1 class="mt-4 font-display text-[clamp(2.6rem,7vw,4.6rem)] leading-[1.03] tracking-tight text-cream">
            录像厅的<br />最后一排
          </h1>

          <p class="mt-5 max-w-xl text-[15px] leading-8 text-cream/60 text-pretty">
            一块钱一场，两片连放。木椅子、吊扇、门口那块洗得发白的棉布帘子，还有屏幕亮起来时，光柱里慢慢飘的灰尘。后来有了 VCD、DVD，再后来，电视里也能看整夜。
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="stamp text-mustard">今晚放映</span>
            <span class="stamp text-cream/55">票价 ¥3.00</span>
            <span class="stamp text-vermilion-soft">不对号入座</span>
            <span class="font-mono text-[10px] tracking-[0.16em] text-cream/35">在架 {movies.length} 部 · VHS / DVD / 电视</span>
          </div>

          <div class="mt-8 border-l-2 border-vermilion pl-4">
            <p class="font-display text-sm italic leading-7 text-cream/70">
              「票在门口买，散场从侧门走。看到一半有人掀帘子进来，光漏在幕布上，全场都回头看。」
            </p>
            <p class="mt-2 font-mono text-[9px] tracking-[0.2em] text-cream/30">— 某个暑假的晚上，录像厅后排</p>
          </div>
        </div>

        <Reveal direction="scale" class="relative">
          <!-- VHS 录像带 -->
          <div class="relative mx-auto w-full max-w-sm -rotate-[1.5deg]">
            <div class="border-[1.5px] border-cream/30 bg-night-soft p-3 shadow-[10px_10px_0_rgba(0,0,0,0.45)]">
              <div class="flex items-center justify-between font-mono text-[8px] tracking-[0.2em] text-cream/35">
                <span>VHS · SP</span>
                <span>GOLDEN YEARS VIDEO CLUB</span>
                <span>120 MIN</span>
              </div>
              <div class="mt-2 border border-cream/20 bg-ink p-3">
                <div class="flex items-center justify-between">
                  <span class="relative grid h-14 w-14 shrink-0 place-items-center rounded-full border border-cream/25 bg-[radial-gradient(circle,rgba(251,247,236,0.12),transparent_70%)]">
                    <span class="h-9 w-9 rounded-full border border-cream/20"></span>
                    <span class="absolute h-2 w-2 rounded-full bg-mustard/80"></span>
                  </span>
                  <span
                    class="mx-3 h-9 flex-1 border-y border-cream/15 bg-[repeating-linear-gradient(90deg,rgba(251,247,236,0.08)_0_10px,transparent_10px_20px)]"
                    aria-hidden="true"></span>
                  <span class="relative grid h-14 w-14 shrink-0 place-items-center rounded-full border border-cream/25 bg-[radial-gradient(circle,rgba(251,247,236,0.12),transparent_70%)]">
                    <span class="h-9 w-9 rounded-full border border-cream/20"></span>
                    <span class="absolute h-2 w-2 rounded-full bg-mustard/80"></span>
                  </span>
                </div>
                <div class="relative mt-3 -rotate-[0.5deg] border border-ink bg-cream px-3 py-2 text-ink">
                  <div class="flex items-baseline justify-between font-mono text-[8px] tracking-[0.14em] text-ink-faint">
                    <span>片名 TITLE</span>
                    <span>NO. 04</span>
                  </div>
                  <p class="mt-1 line-clamp-1 font-display text-base leading-tight">{tapeTitle}</p>
                  <div class="mt-1 flex justify-between font-mono text-[8px] tracking-[0.08em] text-ink-soft">
                    <span>主演（自己写）</span>
                    <span>片长 ______ 分</span>
                  </div>
                </div>
              </div>
              <div class="mt-2 flex justify-between font-mono text-[8px] tracking-[0.16em] text-cream/25">
                <span>BE KIND · REWIND</span>
                <span>SP · STEREO</span>
              </div>
            </div>
          </div>

          <!-- 今晚排片 -->
          {
            showtimeRows.length > 0 && (
              <div class="mx-auto mt-5 max-w-sm border-[1.5px] border-cream/25 bg-night-soft/80 p-3">
                <div class="flex items-center justify-between font-mono text-[8px] tracking-[0.2em] text-cream/35">
                  <span>TONIGHT · 今晚排片</span>
                  <span>通宵场 +2 元</span>
                </div>
                <ul class="mt-2 divide-y divide-cream/10">
                  {showtimeRows.map((row) => (
                    <li class="flex items-center gap-3 py-1.5">
                      <span class="shrink-0 font-mono text-[10px] tracking-[0.1em] text-mustard">{row.time}</span>
                      <span class="h-px flex-1 bg-cream/15" aria-hidden="true"></span>
                      <span class="line-clamp-1 font-display text-sm text-cream/80">{row.movie.title}</span>
                      <span class="shrink-0 font-mono text-[8px] tracking-[0.1em] text-cream/30">{row.movie.type}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </Reveal>
      </div>
    </div>

    <!-- 流动放映字幕 -->
    <div class="relative z-10 overflow-hidden border-t border-cream/10 bg-night-soft/60 py-2">
      <div class="marquee-track">
        {
          tickerItems.map((item) => (
            <span class="mx-5 inline-flex items-center gap-5 whitespace-nowrap font-mono text-[10px] tracking-[0.26em] text-cream/45">
              <span>{item}</span>
              <span class="h-1 w-1 rounded-full bg-vermilion-soft" aria-hidden="true" />
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ 今夜放映 ============================ -->
  {
    reel.length > 0 && (
      <section class="relative overflow-hidden border-t border-cream/10 bg-night pb-14 pt-12 text-cream sm:pb-16 sm:pt-14">
        <div class="film-perf absolute inset-x-0 top-0 h-4" aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_30%_0%,rgba(194,59,42,0.14),transparent_55%)]"
          aria-hidden="true"
        />
        <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <div class="mb-8 flex items-end justify-between gap-4 border-b border-cream/10 pb-4">
            <div>
              <p class="label-mono text-mustard">Now Showing</p>
              <p class="mt-1 font-display text-xl text-cream">今晚，只放这一部</p>
            </div>
            <span class="font-mono text-[9px] tracking-[0.2em] text-cream/30">20:00 开门 · 22:10 开演</span>
          </div>
          <FeaturedReel movies={reel} />
        </div>
      </section>
    )
  }

  <!-- ============================ 海报墙 ============================ -->
  <section id="posters" class="relative overflow-hidden bg-night pb-20 pt-12 text-cream sm:pb-24 sm:pt-16">
    <div class="film-perf absolute inset-x-0 top-0 h-4 border-y border-cream/10" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_10%,rgba(108,147,168,0.1),transparent_50%)]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-[11px] font-bold tracking-[0.3em] text-mustard">POSTER WALL</span>
            <span class="h-px w-10 bg-cream/30" aria-hidden="true"></span>
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-cream/40">Now Showing</span>
          </div>
          <h2 class="mt-3 font-display text-[clamp(1.9rem,4.5vw,3.1rem)] leading-[1.15] text-cream">海报墙</h2>
          <div class="mt-4 flex items-center gap-2" aria-hidden="true">
            <span class="h-[3px] w-12 bg-mustard"></span>
            <span class="h-[3px] w-3 bg-cream/40"></span>
            <span class="h-[3px] w-1.5 bg-cream/25"></span>
          </div>
          <p class="mt-5 max-w-2xl text-[15px] leading-8 text-cream/55 text-pretty">
            每一张海报背后，都是一个在别人家电视前坐不住的下午。点开任意一部，能看到完整的影片档案；也可以按类型、年代、地区检索，或者搜片名、导演、台词。
          </p>
        </div>
        <Reveal class="shrink-0">
          <p class="border-[1.5px] border-cream/25 bg-night-soft px-4 py-2 font-mono text-[10px] tracking-[0.18em] text-cream/50">
            片库 <span class="text-mustard">{movies.length}</span> 部 · 通宵场 +2 元
          </p>
        </Reveal>
      </div>

      <div class="mt-10" data-collection>
        <!-- 售票窗口 -->
        <div class="border-[1.5px] border-ink bg-cream text-ink shadow-print">
          <div class="flex flex-col gap-4 border-b border-ink/15 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
            <div>
              <p class="label-mono text-vermilion">Ticket Window · 售票窗口</p>
              <p class="mt-1 text-sm text-ink-soft">挑类型、挑年代、挑地区，或者在检索口写一个词。</p>
            </div>
            <label class="relative block">
              <span class="sr-only">搜索影视</span>
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 font-mono text-[9px] tracking-[0.14em] text-ink-faint">SEARCH</span>
              <input
                type="search"
                data-search-input
                placeholder="片名 / 导演 / 台词"
                class="w-full border-[1.5px] border-ink bg-cream py-2 pl-[4.5rem] pr-8 font-body text-sm text-ink placeholder:text-ink-faint/70 focus:outline-none focus:ring-0 sm:w-64"
              />
              <kbd class="pointer-events-none absolute right-2.5 top-1/2 hidden -translate-y-1/2 border border-ink/20 px-1 font-mono text-[9px] text-ink-faint sm:block">/</kbd>
            </label>
          </div>

          <div class="grid gap-4 p-4 sm:p-5 lg:grid-cols-3">
            <div>
              <p class="label-mono text-[9px] text-ink-faint">类型 · TYPE</p>
              <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="按类型筛选">
                <button type="button" class={chipClass} data-filter data-filter-key="type" data-filter-value="all">全部</button>
                {
                  types.map((type) => (
                    <button type="button" class={chipClass} data-filter data-filter-key="type" data-filter-value={type}>
                      {type}
                    </button>
                  ))
                }
              </div>
            </div>
            <div>
              <p class="label-mono text-[9px] text-ink-faint">年代 · ERA</p>
              <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="按年代筛选">
                <button type="button" class={chipClass} data-filter data-filter-key="era" data-filter-value="all">全部</button>
                {
                  eras.map((era) => (
                    <button type="button" class={chipClass} data-filter data-filter-key="era" data-filter-value={era}>
                      {era}
                    </button>
                  ))
                }
              </div>
            </div>
            <div>
              <p class="label-mono text-[9px] text-ink-faint">地区 · REGION</p>
              <div class="mt-2 flex flex-wrap gap-1.5" role="group" aria-label="按地区筛选">
                <button type="button" class={chipClass} data-filter data-filter-key="region" data-filter-value="all">全部</button>
                {
                  regions.map((region) => (
                    <button type="button" class={chipClass} data-filter data-filter-key="region" data-filter-value={region}>
                      {region}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between border-t border-ink/15 px-4 py-2.5 font-mono text-[10px] tracking-[0.14em] text-ink-faint sm:px-5">
            <span>检索结果 <span class="text-vermilion" data-result-count>{movies.length}</span> / {movies.length} 部</span>
            <span class="hidden sm:inline">按「/」快速搜索</span>
          </div>
        </div>

        <!-- 海报网格 -->
        <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-9 sm:grid-cols-3 sm:gap-x-5 lg:grid-cols-4">
          {movies.map((movie, index) => <PosterCard movie={movie} index={index} />)}
        </div>

        <!-- 空状态 -->
        <div
          data-empty
          hidden
          class="mt-8 border-[1.5px] border-dashed border-cream/25 bg-night-soft px-6 py-16 text-center"
        >
          <p class="font-display text-2xl text-cream">今晚这场，没有排片</p>
          <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-cream/50">
            换一个类型、年代或地区试试；搜索词也可以写短一点，比如只写导演的名字。
          </p>
          <span class="stamp mt-6 inline-block text-cream/35">SORRY · SOLD OUT</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ 结尾引导 ============================ -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <Reveal>
      <div class="relative overflow-hidden border-[1.5px] border-ink bg-cream px-6 py-12 shadow-print grain sm:px-10 sm:py-14">
        <div
          class="pointer-events-none absolute -right-6 -top-12 select-none font-display text-[11rem] leading-none text-ink/[0.05]"
          aria-hidden="true"
        >
          散
        </div>
        <div class="relative grid gap-8 md:grid-cols-[1.1fr_1fr] md:items-center">
          <div>
            <p class="label-mono text-vermilion">After the Show · 散场之后</p>
            <h2 class="mt-3 font-display text-[clamp(1.9rem,4.4vw,2.9rem)] leading-tight text-ink">灯亮了，先别急着走</h2>
            <p class="mt-4 max-w-lg text-sm leading-7 text-ink-soft">
              片尾字幕放完，有人还坐在椅子上。回家的路上，把刚才那句台词又学了一遍。
            </p>
            <div class="mt-6 flex flex-wrap gap-2">
              <span class="stamp text-jade">片尾曲放完再走</span>
              <span class="stamp text-ink-faint">录像厅 1980—2009</span>
            </div>
          </div>
          <div class="grid gap-2 sm:grid-cols-2">
            <a
              href="/music/"
              class="group border-[1.5px] border-ink bg-paper px-4 py-3 transition-colors hover:bg-mustard/30"
            >
              <span class="block font-mono text-[9px] tracking-[0.24em] text-ink-faint">Listen · 02</span>
              <span class="mt-1 flex items-center justify-between font-display text-lg text-ink">
                音乐 · 卡带
                <span class="font-mono text-xs text-vermilion transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
            <a
              href="/books/"
              class="group border-[1.5px] border-ink bg-paper px-4 py-3 transition-colors hover:bg-mustard/30"
            >
              <span class="block font-mono text-[9px] tracking-[0.24em] text-ink-faint">Read · 03</span>
              <span class="mt-1 flex items-center justify-between font-display text-lg text-ink">
                书籍 · 书单
                <span class="font-mono text-xs text-vermilion transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
            <a
              href="/toys/"
              class="group border-[1.5px] border-ink bg-paper px-4 py-3 transition-colors hover:bg-mustard/30"
            >
              <span class="block font-mono text-[9px] tracking-[0.24em] text-ink-faint">Collect · 05</span>
              <span class="mt-1 flex items-center justify-between font-display text-lg text-ink">
                老物件 · 抽屉
                <span class="font-mono text-xs text-vermilion transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
            <a
              href="/timeline/"
              class="group border-[1.5px] border-ink bg-paper px-4 py-3 transition-colors hover:bg-mustard/30"
            >
              <span class="block font-mono text-[9px] tracking-[0.24em] text-ink-faint">Rewind · 01</span>
              <span class="mt-1 flex items-center justify-between font-display text-lg text-ink">
                时光轴 · 那一年
                <span class="font-mono text-xs text-vermilion transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </Reveal>
  </section>
</BaseLayout>

<style is:global>
  .film-perf {
    background-color: var(--color-night);
    background-image: repeating-linear-gradient(
      90deg,
      transparent 0 12px,
      rgba(251, 247, 236, 0.18) 12px 25px
    );
  }

  .film-perf-y {
    background-color: var(--color-night);
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0 12px,
      rgba(251, 247, 236, 0.18) 12px 25px
    );
  }

  @keyframes poster-card-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-item].is-filtered-in {
    animation: poster-card-in 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-item].is-filtered-in {
      animation: none;
    }
  }
</style>
