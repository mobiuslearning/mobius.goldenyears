---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/shared/SectionHeader.astro';
import Reveal from '../components/shared/Reveal.astro';
import { site, eras } from '../data/site';
import { allEvents } from '../data/events';
import { songs } from '../data/culture/music';
import { movies } from '../data/culture/movies';
import { toys } from '../data/nostalgia/toys';

const tmData = {
  minYear: site.startYear,
  maxYear: site.endYear,
  events: allEvents.map((event) => ({
    y: event.year,
    s: event.scope,
    c: event.category,
    t: event.title,
    d: event.description,
  })),
  songs: songs.map((song) => ({
    y: song.year,
    t: song.title,
    a: song.artist,
    r: song.region,
    l: song.lyric,
    d: song.description,
  })),
  movies: movies.map((movie) => ({
    y: movie.year,
    t: movie.title,
    ty: movie.type,
    r: movie.region,
    q: movie.quote,
    d: movie.description,
  })),
  toys: toys.map((toy) => ({
    y: toy.yearStart,
    e: toy.yearEnd,
    n: toy.name,
    c: toy.category,
    d: toy.description,
    m: toy.memory,
  })),
  eras: eras.map((era) => ({
    id: era.id,
    label: era.label,
    years: era.years,
    name: era.name,
    mood: era.mood,
  })),
};
const tmJson = JSON.stringify(tmData).replace(/</g, '\\u003c');

const steps = [
  { index: '01', title: '输入出生年份', text: '1980—2009 之间的任意一年，或者直接按 90、95 这样的两位数输入。' },
  { index: '02', title: '生成本人的记忆卡', text: '那一年的大事、你几岁、童年在哪几年、青春期的背景音乐。' },
  { index: '03', title: '带走 / 分享', text: '一键复制成一段文字，发给同年代的朋友，看看谁还记得。' },
];
---

<BaseLayout title="你的年代记忆卡" description="输入你的出生年份，生成一张属于 80 后、90 后的年代记忆卡：出生那年的中国与世界、童年 BGM、玩过的玩具、看过的影视。">
  <!-- ============================== HERO ============================== -->
  <section class="relative overflow-hidden bg-night pb-16 pt-14 text-cream sm:pb-20 sm:pt-20">
    <div class="pointer-events-none absolute inset-0 opacity-[0.08] line-grid"></div>
    <div class="scanlines pointer-events-none absolute inset-0 opacity-50"></div>
    <div class="pointer-events-none absolute -left-24 top-10 h-72 w-72 rounded-full border-[18px] border-vermilion/10"></div>
    <div class="pointer-events-none absolute -right-16 bottom-0 h-56 w-56 rounded-full border-[14px] border-mustard/10"></div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="font-mono text-[10px] tracking-[0.3em] text-mustard">GY-TM / OS v1.0 · ONLINE</p>
        <div class="flex items-center gap-2 font-mono text-[10px] tracking-[0.22em] text-cream/40">
          <span class="h-1.5 w-1.5 animate-blink rounded-full bg-jade"></span>
          SIGNAL READY
        </div>
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
        <div>
          <h1 class="font-display text-[clamp(2.8rem,7vw,5.5rem)] leading-[0.95]">
            时光机
            <span class="mt-2 block text-stroke-cream text-[0.42em] tracking-[0.3em]">TIME MACHINE</span>
          </h1>
          <p class="mt-6 max-w-lg text-[15px] leading-8 text-cream/65">
            告诉我你出生的年份。我会去档案里翻出那一年，看看世界发生了什么、电视里在放什么歌，
            再把你长大的那十几年，拼成一张只属于你的卡。
          </p>

          <form data-tm-form class="mt-8 max-w-xl" novalidate>
            <label for="tm-birth" class="font-mono text-[10px] tracking-[0.26em] text-cream/50">输入出生年份 / BIRTH YEAR</label>
            <div class="mt-3 flex flex-wrap items-stretch gap-3">
              <div class="flex flex-1 items-center gap-2 border-[1.5px] border-cream/30 bg-night-soft px-4 focus-within:border-mustard">
                <input
                  id="tm-birth"
                  data-tm-input
                  name="birth"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  maxlength="4"
                  placeholder="1990"
                  class="w-full bg-transparent py-4 font-mono text-2xl tracking-[0.3em] text-cream outline-none placeholder:text-cream/20"
                />
                <span class="shrink-0 font-mono text-[11px] tracking-[0.2em] text-cream/40">年</span>
              </div>
              <button type="submit" class="btn-retro border-mustard bg-mustard text-ink hover:bg-cream">
                启动机器
              </button>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              <span class="font-mono text-[10px] tracking-[0.18em] text-cream/35">快速选择</span>
              {[1985, 1990, 1995, 2000].map((year) => (
                <a
                  href={`/time-machine/?birth=${year}`}
                  class="border border-cream/20 px-2.5 py-1 font-mono text-[10px] tracking-[0.16em] text-cream/60 transition-colors hover:border-mustard hover:text-mustard"
                >
                  {year}
                </a>
              ))}
              <span class="ml-auto hidden font-mono text-[9px] tracking-[0.18em] text-cream/25 sm:block">1980 — 2009</span>
            </div>
          </form>
        </div>

        <div class="relative">
          <div class="border-[1.5px] border-cream/20 bg-night-soft/70 p-5">
            <div class="flex items-center justify-between border-b border-cream/15 pb-3">
              <span class="font-mono text-[9px] tracking-[0.26em] text-cream/40">SYSTEM CHECK</span>
              <span class="flex gap-1.5"><i class="h-2 w-2 rounded-full bg-vermilion"></i><i class="h-2 w-2 rounded-full bg-mustard"></i><i class="h-2 w-2 rounded-full bg-jade"></i></span>
            </div>
            <div class="mt-4 space-y-3 font-mono text-[11px] leading-5">
              <p class="flex justify-between"><span class="text-cream/35">EVENT ARCHIVE</span><span class="text-cream">{String(allEvents.length).padStart(3, '0')} RECORDS</span></p>
              <p class="flex justify-between"><span class="text-cream/35">MUSIC TAPES</span><span class="text-cream">{String(songs.length).padStart(3, '0')} TRACKS</span></p>
              <p class="flex justify-between"><span class="text-cream/35">FILM REELS</span><span class="text-cream">{String(movies.length).padStart(3, '0')} POSTERS</span></p>
              <p class="flex justify-between"><span class="text-cream/35">OBJECTS</span><span class="text-cream">{String(toys.length).padStart(3, '0')} ITEMS</span></p>
              <p class="flex justify-between border-t border-cream/10 pt-3"><span class="text-cream/35">RANGE</span><span class="text-mustard">1980 — 2009</span></p>
            </div>
            <div class="mt-5 flex items-end gap-[3px]" aria-hidden="true">
              {Array.from({ length: 32 }).map((_, index) => (
                <span class="w-full bg-gradient-to-t from-vermilion/70 to-mustard/80" style={`height:${6 + ((index * 11) % 34)}px`}></span>
              ))}
            </div>
            <p class="mt-4 border-t border-cream/15 pt-3 font-mono text-[9px] leading-5 tracking-[0.16em] text-cream/30">
              MEMORY MODULE READY<br />PLEASE ENTER BIRTH YEAR
            </p>
          </div>
          <span class="absolute -bottom-3 right-4 rotate-2 border-[1.5px] border-cream/30 bg-night px-2 py-1 font-mono text-[9px] tracking-[0.2em] text-cream/50">
            NO. 1980—2009
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== 结果区 ============================== -->
  <section class="relative bg-paper-texture py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeader index="Output" eyebrow="Your Memory Card" title="你的年代记忆卡" description="根据档案里收录的 1980—2009 年内容生成。换一个出生年份，会是完全不同的一张卡。" accent="vermilion" />
        <div class="flex flex-wrap items-center gap-3">
          <p data-tm-note class="max-w-xs text-right font-mono text-[10px] leading-5 tracking-[0.12em] text-ink-faint"></p>
        </div>
      </div>

      <noscript>
        <div class="mt-10 border-[1.5px] border-ink bg-cream p-6 shadow-print">
          <p class="font-display text-xl text-ink">这台机器需要 JavaScript 才能启动</p>
          <p class="mt-2 text-sm leading-7 text-ink-soft">
            记忆卡由浏览器现场计算生成，请在浏览器设置中启用 JavaScript。你也可以先去
            <a href="/timeline/" class="font-medium text-vermilion underline">完整时光轴</a> 或
            <a href="/music/" class="font-medium text-vermilion underline">音乐</a> 页面逛逛。
          </p>
        </div>
      </noscript>

      <div data-tm-placeholder class="mt-10 border-[1.5px] border-dashed border-ink/30 bg-cream/50 p-8 text-center">
        <p class="font-display text-xl text-ink">机器正在等待一个年份。</p>
        <p class="mt-2 text-sm text-ink-soft">在上方输入 1980—2009 之间的年份，按「启动机器」。</p>
      </div>

      <div data-tm-results hidden aria-live="polite" class="mt-10 space-y-14">
        <!-- 记忆卡 -->
        <div data-tm-summary></div>

        <!-- 关键年份 -->
        <div>
          <div class="flex items-baseline justify-between gap-4 border-b-[1.5px] border-ink/20 pb-3">
            <h2 class="font-display text-2xl text-ink">你人生里的几个年份</h2>
            <span class="font-mono text-[10px] tracking-[0.2em] text-ink-faint">MILESTONES</span>
          </div>
          <div data-tm-milestones class="mt-6 space-y-10"></div>
        </div>

        <!-- 歌单 + 玩具 -->
        <div class="grid gap-5 lg:grid-cols-2">
          <div class="paper-card p-6 sm:p-7">
            <div class="flex items-baseline justify-between gap-3 border-b border-ink/15 pb-3">
              <h2 class="font-display text-2xl text-ink">你的年代歌单</h2>
              <span class="font-mono text-[10px] tracking-[0.2em] text-ink-faint">SIDE A</span>
            </div>
            <ul data-tm-songs class="mt-2"></ul>
            <p class="mt-4 font-mono text-[9px] leading-5 tracking-[0.14em] text-ink-faint">
              从童年到青春期，收录范围内最接近的几首。
            </p>
          </div>

          <div class="paper-card p-6 sm:p-7">
            <div class="flex items-baseline justify-between gap-3 border-b border-ink/15 pb-3">
              <h2 class="font-display text-2xl text-ink">你玩过的东西</h2>
              <span class="font-mono text-[10px] tracking-[0.2em] text-ink-faint">OBJECTS</span>
            </div>
            <ul data-tm-toys class="mt-4 grid gap-2 sm:grid-cols-2"></ul>
          </div>
        </div>

        <!-- 影视 -->
        <div class="paper-card p-6 sm:p-7">
          <div class="flex items-baseline justify-between gap-3 border-b border-ink/15 pb-3">
            <h2 class="font-display text-2xl text-ink">那几年看过的影视</h2>
            <span class="font-mono text-[10px] tracking-[0.2em] text-ink-faint">SCREEN</span>
          </div>
          <ul data-tm-movies class="mt-2 sm:columns-2 sm:gap-10"></ul>
        </div>

        <!-- 大事 -->
        <div>
          <div class="flex items-baseline justify-between gap-4 border-b-[1.5px] border-ink/20 pb-3">
            <h2 class="font-display text-2xl text-ink">你长大那几年，世界发生了什么</h2>
            <span class="font-mono text-[10px] tracking-[0.2em] text-ink-faint">ARCHIVE</span>
          </div>
          <ul data-tm-events class="mt-3"></ul>
        </div>

        <!-- 复制 -->
        <div class="flex flex-wrap items-center gap-4 border-[1.5px] border-ink bg-night p-6 text-cream shadow-print sm:justify-between sm:p-8">
          <div>
            <p class="font-display text-2xl">把这张卡带走</p>
            <p class="mt-1 text-sm text-cream/55">复制成一段文字，发给和你同一年出生的人。</p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" data-tm-copy class="btn-retro border-mustard bg-mustard text-ink hover:bg-cream">复制记忆卡</button>
            <span data-tm-copy-status class="font-mono text-[10px] tracking-[0.14em] text-cream/60"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== 使用说明 ============================== -->
  <section class="border-t border-ink/10 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Reveal>
        <SectionHeader index="Manual" eyebrow="How it works" title="这台机器怎么用" description="没有登录、没有算法推荐，所有内容都来自这个站点收录的年代档案。" accent="jade" />
      </Reveal>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          steps.map((step, index) => (
            <Reveal delay={index * 80}>
              <div class="paper-card h-full p-6">
                <span class="font-mono text-[11px] tracking-[0.24em] text-jade">{step.index}</span>
                <h3 class="mt-4 font-display text-xl text-ink">{step.title}</h3>
                <p class="mt-2 text-sm leading-7 text-ink-soft">{step.text}</p>
              </div>
            </Reveal>
          ))
        }
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        <a href="/timeline/" class="btn-retro">去看完整时光轴</a>
        <a href="/music/" class="btn-retro">打开磁带架</a>
        <a href="/toys/" class="btn-retro">逛老物件博物馆</a>
      </div>
    </div>
  </section>

  <script type="application/json" data-tm-data set:html={tmJson}></script>
  <script>
    import '../scripts/time-machine';
  </script>
</BaseLayout>
