---
/**
 * 老物件详情：/toys/<id>/
 * 记忆博物馆的单件展品页面：展柜大图（实拍图优先，无图用 CoverArt）、
 * 展签正文、玩法、私人记忆、那一年、实物照片、同类推荐、上一件 / 下一件。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/shared/SectionHeader.astro';
import Reveal from '../../components/shared/Reveal.astro';
import CoverArt from '../../components/shared/CoverArt.astro';
import PhotoFrame from '../../components/nostalgia/PhotoFrame.astro';
import { categoryTone, eraOfYear, yearsLabel } from '../../components/nostalgia/museum';
import {
  collectImages,
  eventsForYear,
  neighborsOf,
  relatedFor,
  storyParagraphs,
  yearHref,
} from '../../components/nostalgia/detail';
import { toys } from '../../data/nostalgia/toys';
import type { NostalgiaItem } from '../../types';

export async function getStaticPaths() {
  return toys.map((item, index) => ({
    params: { id: item.id },
    props: { item, index },
  }));
}

interface Props {
  item: NostalgiaItem;
  index: number;
}

const { item, index } = Astro.props;

const no = String(index + 1).padStart(2, '0');
const total = toys.length;
const tone = categoryTone(item.category);
const era = eraOfYear(item.yearStart);
const years = yearsLabel(item);
const images = collectImages(item);
const primaryImage = images[0];
const gallery = images.slice(1);
const story = storyParagraphs(item.story);
const howTo = item.howTo ?? [];
const events = eventsForYear(item.yearStart, 3);
const related = relatedFor(item);
const neighbors = neighborsOf(item.id);
const yearLabel = item.yearStart;

const metaDescription = item.description.length > 110
  ? `${item.description.slice(0, 108)}……`
  : item.description;

const catalogRows = [
  { label: '馆藏编号', value: `NO. ${no} / ${total}` },
  { label: '类别', value: item.category },
  { label: '流行年份', value: years },
  { label: '年代', value: era },
  ...(item.aliases && item.aliases.length > 0
    ? [{ label: '别名', value: item.aliases.join(' / ') }]
    : []),
  { label: '玩法', value: howTo.length > 0 ? `${howTo.length} 步` : '未记录' },
];
---
<BaseLayout title={`${item.name} · 老物件`} description={metaDescription}>
  <!-- Hero：展品与展签 -->
  <section class="relative overflow-hidden bg-night text-cream">
    <div class="pointer-events-none absolute inset-0 opacity-[0.06] line-grid" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -top-40 left-[14%] h-[26rem] w-[22rem] rounded-full bg-mustard/20 blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-48 right-[8%] h-[24rem] w-[26rem] rounded-full bg-vermilion/15 blur-[130px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <nav
        class="flex flex-wrap items-center gap-2 font-mono text-[9px] tracking-[0.18em] text-cream/40"
        aria-label="面包屑"
      >
        <a href="/" class="transition-colors hover:text-mustard">首页</a>
        <span aria-hidden="true">/</span>
        <a href="/toys/" class="transition-colors hover:text-mustard">记忆博物馆</a>
        <span aria-hidden="true">/</span>
        <span class="text-cream/70">{item.name}</span>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-center lg:gap-14">
        <!-- 展柜 -->
        <div class="relative mx-auto w-full max-w-md lg:mx-0">
          <span class="stamp absolute -left-2 top-4 z-20 bg-night text-mustard">
            {item.featured ? '重点展品' : '馆藏'} · NO. {no}
          </span>

          <div class="relative border-[1.5px] border-cream/25 bg-cream/[0.045] p-3">
            <span class="absolute left-2 top-2 h-2.5 w-2.5 border-l border-t border-cream/60" aria-hidden="true"></span>
            <span class="absolute right-2 top-2 h-2.5 w-2.5 border-r border-t border-cream/60" aria-hidden="true"></span>
            <span class="absolute bottom-2 left-2 h-2.5 w-2.5 border-b border-l border-cream/60" aria-hidden="true"></span>
            <span class="absolute bottom-2 right-2 h-2.5 w-2.5 border-b border-r border-cream/60" aria-hidden="true"></span>

            {
              primaryImage ? (
                <PhotoFrame image={primaryImage} tone="dark" eager class="relative" />
              ) : (
                <div class="relative overflow-hidden border border-cream/15">
                  <CoverArt
                    title={item.name}
                    subtitle={item.aliases?.[0] ?? item.category}
                    year={item.yearStart}
                    kind="toy"
                    ratio="landscape"
                  />
                  <span
                    class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-transparent via-cream/15 to-transparent"
                    aria-hidden="true"
                  ></span>
                </div>
              )
            }
          </div>

          <div class="mx-auto h-3 w-[94%] border-x border-b border-cream/20 bg-night-soft" aria-hidden="true"></div>
          <p class="mt-3 flex items-center justify-between font-mono text-[9px] tracking-[0.18em] text-cream/35">
            <span>{primaryImage ? '实拍图 · 署名见图片下方' : '展品图 · 程序生成'}</span>
            <span>{item.category} · {item.yearStart}</span>
          </p>
        </div>

        <!-- 展签信息 -->
        <div class="relative">
          <div class="flex flex-wrap items-center gap-3">
            <span class="stamp shrink-0 text-mustard">{item.category}</span>
            <span class="font-mono text-[9px] tracking-[0.22em] text-cream/40">
              {era} · 馆藏 NO. {no} / {total}
            </span>
          </div>

          <h1
            class="mt-4 font-display text-[clamp(2.4rem,5.6vw,3.9rem)] leading-[1.04] tracking-tight text-cream text-balance"
          >
            {item.name}
          </h1>

          {
            item.aliases && item.aliases.length > 0 && (
              <p class="mt-3 text-sm leading-6 text-cream/50">
                <span class="font-mono text-[10px] tracking-[0.18em] text-cream/40">又名</span>{' '}
                {item.aliases.join(' / ')}
              </p>
            )
          }

          <p class="mt-6 max-w-xl text-[15px] leading-8 text-cream/65 text-pretty">{item.description}</p>

          <dl class="mt-7 flex flex-wrap gap-x-8 gap-y-3 border-y border-cream/15 py-4">
            <div>
              <dt class="font-mono text-[8px] tracking-[0.22em] text-cream/35">流行年份</dt>
              <dd class="mt-1 font-display text-lg text-cream">{years}</dd>
            </div>
            <div>
              <dt class="font-mono text-[8px] tracking-[0.22em] text-cream/35">类别</dt>
              <dd class="mt-1 font-display text-lg text-cream">{item.category}</dd>
            </div>
            <div>
              <dt class="font-mono text-[8px] tracking-[0.22em] text-cream/35">玩法</dt>
              <dd class="mt-1 font-display text-lg text-cream">
                {howTo.length > 0 ? `${howTo.length} 步` : '未记录'}
              </dd>
            </div>
          </dl>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="#label" class="btn-retro">读展签</a>
            <a
              href="/toys/"
              class="inline-flex items-center gap-2 border-b border-cream/30 pb-1 font-mono text-[10px] tracking-[0.16em] text-cream/55 transition-colors hover:border-mustard hover:text-mustard"
            >
              <span aria-hidden="true">←</span> 返回博物馆
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 展签正文 -->
  <section id="label" class="relative scroll-mt-20 py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_21rem] lg:gap-14">
        <div class="min-w-0">
          <Reveal>
            <SectionHeader
              index="01"
              eyebrow="Exhibit Label"
              title="展签背面"
              description="一件东西被用过、被弄丢过、被重新提起过，才算真的存在过。这里写的是它的来路和玩法。"
            />
          </Reveal>

          {
            story.length > 0 ? (
              <Reveal delay={60}>
                <div class="mt-8">
                  <h3 class="font-display text-xl leading-snug text-ink">它的来路</h3>
                  <div class="mt-3 space-y-4 text-[15px] leading-8 text-ink-soft text-pretty">
                    {story.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                </div>
              </Reveal>
            ) : (
              <Reveal delay={60}>
                <p class="mt-8 border-l-[3px] border-ink/20 pl-4 text-sm leading-7 text-ink-faint">
                  这件展品暂时只有一段短展签，更长的记录还在整理。
                </p>
              </Reveal>
            )
          }

          <Reveal delay={120}>
            <div class="mt-10 border-t-[1.5px] border-dashed border-ink/20 pt-8">
              <h3 class="font-display text-xl leading-snug text-ink">怎么玩 / 怎么用</h3>
              {
                howTo.length > 0 ? (
                  <ol class="relative mt-5 space-y-5 border-l-[1.5px] border-dashed border-ink/30 pl-7">
                    {howTo.map((step, stepIndex) => (
                      <li class="relative">
                        <span
                          class="absolute -left-7 top-0 grid h-6 w-6 -translate-x-1/2 place-items-center rounded-full border-[1.5px] border-ink bg-cream font-mono text-[10px] font-bold"
                          style={`color:${tone};`}
                        >
                          {stepIndex + 1}
                        </span>
                        <p class="text-sm leading-7 text-ink-soft">{step}</p>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <p class="mt-3 text-sm leading-7 text-ink-faint">没有留下玩法记录，只记得它存在过。</p>
                )
              }
            </div>
          </Reveal>

          {
            item.memory && (
              <Reveal delay={180}>
                <blockquote
                  class="relative mt-10 border-[1.5px] border-ink bg-cream p-5 shadow-print sm:p-6"
                  style={`border-left:6px solid ${tone};`}
                >
                  <span
                    aria-hidden="true"
                    class="absolute right-4 top-2 select-none font-display text-5xl leading-none opacity-15"
                    style={`color:${tone};`}
                  >
                    ”
                  </span>
                  <p class="font-mono text-[9px] tracking-[0.24em] text-ink-faint">私人记忆 / MEMORY</p>
                  <p class="relative mt-3 font-display text-[clamp(1.05rem,2vw,1.3rem)] leading-8 text-ink/85">
                    「{item.memory}」
                  </p>
                </blockquote>
              </Reveal>
            )
          }
        </div>

        <!-- 档案卡 -->
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="border-[1.5px] border-ink bg-cream shadow-print">
            <div
              class="flex items-center justify-between border-b-[1.5px] border-dashed border-ink/20 px-4 py-3 font-mono text-[9px] tracking-[0.22em] text-ink-faint"
            >
              <span>CATALOG CARD</span>
              <span class="text-vermilion">{era}</span>
            </div>
            <dl class="divide-y divide-ink/10 px-4">
              {
                catalogRows.map((row) => (
                  <div class="flex items-baseline justify-between gap-4 py-2.5">
                    <dt class="shrink-0 font-mono text-[9px] tracking-[0.14em] text-ink-faint">{row.label}</dt>
                    <dd class="text-right text-[12px] leading-5 text-ink-soft">{row.value}</dd>
                  </div>
                ))
              }
            </dl>
            <div class="space-y-2 border-t-[1.5px] border-dashed border-ink/20 p-4 font-mono text-[10px] tracking-[0.14em]">
              <a href="/toys/" class="flex items-center justify-between text-ink-soft transition-colors hover:text-vermilion">
                <span><span aria-hidden="true">←</span> 记忆博物馆</span>
                <span class="text-ink-faint">/toys/</span>
              </a>
              <a
                href={yearHref(yearLabel)}
                class="flex items-center justify-between text-ink-soft transition-colors hover:text-vermilion"
              >
                <span>打开 {yearLabel} 年</span>
                <span aria-hidden="true">→</span>
              </a>
              <a href="/about/#comments" class="flex items-center justify-between text-ink-soft transition-colors hover:text-vermilion">
                <span>记得这个？去留言</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- 那一年 -->
  <section class="relative border-y-[1.5px] border-ink/15 bg-paper-deep/50 py-16 sm:py-20">
    <div class="pointer-events-none absolute inset-0 opacity-40 bg-paper-texture" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <Reveal>
        <SectionHeader
          index="02"
          eyebrow="That Year"
          title={`${yearLabel} 年，它正流行`}
          accent="jade"
          description={`把「${item.name}」放回 ${yearLabel} 年，看看同一年还发生了什么。`}
        />
      </Reveal>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          events.map((event, eventIndex) => (
            <Reveal delay={eventIndex * 60}>
              <a
                href={yearHref(event.year)}
                class="group flex h-full flex-col border-[1.5px] border-ink bg-cream p-5 shadow-print transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[6px_6px_0_0_var(--color-ink)]"
              >
                <div class="flex items-center justify-between gap-2 font-mono text-[9px] tracking-[0.16em]">
                  <span class:list={['stamp', event.scope === 'china' ? 'text-vermilion' : 'text-sky']}>
                    {event.scope === 'china' ? '中国' : '世界'}
                  </span>
                  <span class="text-ink-faint">{event.year} · {event.category}</span>
                </div>
                <p class="mt-4 font-display text-lg leading-snug text-ink">{event.title}</p>
                <p class="mt-2 flex-1 text-[12.5px] leading-6 text-ink-soft">{event.description}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 font-mono text-[9px] tracking-[0.16em] text-ink-faint transition-colors group-hover:text-vermilion">
                  打开 {event.year} 年 <span aria-hidden="true">→</span>
                </span>
              </a>
            </Reveal>
          ))
        }
      </div>

      <Reveal delay={events.length * 60}>
        <a
          href={yearHref(yearLabel)}
          class="group mt-4 flex flex-col gap-3 border-[1.5px] border-dashed border-ink/40 bg-paper-deep px-5 py-4 transition-colors hover:border-ink hover:bg-cream sm:flex-row sm:items-center sm:justify-between"
        >
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <span class="font-mono text-[9px] tracking-[0.2em] text-ink-faint">
              YEAR PAGE · {yearLabel}
            </span>
            <p class="font-display text-lg leading-snug text-ink">
              这一年的歌、书、影视、老物件和大事记，都在年度页里。
            </p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[10px] tracking-[0.16em] text-ink-soft transition-colors group-hover:text-vermilion">
            打开 {yearLabel} 年 <span aria-hidden="true">→</span>
          </span>
        </a>
      </Reveal>
    </div>
  </section>

  <!-- 实拍图画廊 -->
  {
    gallery.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
        <Reveal>
          <SectionHeader
            index="03"
            eyebrow="Photographs"
            title="实物照片"
            accent="mustard"
            description="图片来自公开授权图库（CC0 / 公有领域 / CC BY / CC BY-SA），作者、协议与原始页面逐张标注。"
          />
        </Reveal>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map((image, imageIndex) => (
            <Reveal delay={imageIndex * 60}>
              <PhotoFrame image={image} ratio="landscape" />
            </Reveal>
          ))}
        </div>
      </section>
    )
  }

  <!-- 同类推荐 -->
  {
    related.items.length > 0 && (
      <section class="border-t-[1.5px] border-ink/15 bg-paper-deep/40 py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <Reveal>
            <SectionHeader
              index={gallery.length > 0 ? '04' : '03'}
              eyebrow="More Objects"
              title={related.allSameCategory ? '同类别展品' : '同类与同期展品'}
              accent="vermilion"
              description={
                related.allSameCategory
                  ? '同一门类里，还有这些东西。'
                  : '同门类的展品不多，顺便看看年代相近的几件。'
              }
            />
          </Reveal>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              related.items.map((entry, entryIndex) => {
                const entryImage = collectImages(entry)[0];
                const entryNo = String(toys.findIndex((candidate) => candidate.id === entry.id) + 1).padStart(2, '0');
                return (
                  <Reveal delay={entryIndex * 60}>
                    <a
                      href={`/toys/${entry.id}/`}
                      class="group flex h-full flex-col border-[1.5px] border-ink bg-cream shadow-print-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-print"
                    >
                      <div class="flex items-center justify-between border-b-[1.5px] border-ink/15 px-3 py-2 font-mono text-[8px] tracking-[0.18em] text-ink-faint">
                        <span>NO. {entryNo}</span>
                        <span style={`color:${categoryTone(entry.category)};`}>{entry.category}</span>
                      </div>
                      <div class="relative aspect-[4/3] overflow-hidden border-b-[1.5px] border-ink/15 bg-paper-deep">
                        {entryImage ? (
                          <img
                            src={entryImage.src}
                            alt={entryImage.alt || entry.name}
                            loading="lazy"
                            decoding="async"
                            class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                          />
                        ) : (
                          <CoverArt title={entry.name} year={entry.yearStart} kind="toy" ratio="landscape" class="border-0" />
                        )}
                      </div>
                      <div class="flex flex-1 flex-col px-3.5 pb-3.5 pt-3">
                        <p class="font-display text-lg leading-tight text-ink">{entry.name}</p>
                        <p class="mt-1 font-mono text-[9px] tracking-[0.14em] text-ink-faint">{yearsLabel(entry)}</p>
                        <span class="mt-auto pt-3 font-mono text-[9px] tracking-[0.16em] text-ink-faint transition-colors group-hover:text-vermilion">
                          查看展签 <span aria-hidden="true">→</span>
                        </span>
                      </div>
                    </a>
                  </Reveal>
                );
              })
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- 上一件 / 下一件 -->
  <nav class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-label="展品翻页">
    <div class="grid gap-px border-[1.5px] border-ink bg-ink/20 sm:grid-cols-2">
      {
        neighbors.prev ? (
          <a
            href={`/toys/${neighbors.prev.id}/`}
            class="group flex flex-col gap-2 bg-cream p-5 transition-colors hover:bg-paper sm:p-6"
          >
            <span class="font-mono text-[9px] tracking-[0.2em] text-ink-faint">
              <span aria-hidden="true">←</span> PREVIOUS · 上一件
            </span>
            <span class="font-display text-xl leading-tight text-ink transition-colors group-hover:text-vermilion">
              {neighbors.prev.name}
            </span>
            <span class="font-mono text-[9px] tracking-[0.14em] text-ink-faint">
              {neighbors.prev.category} · {yearsLabel(neighbors.prev)}
            </span>
          </a>
        ) : (
          <p class="flex items-center bg-cream p-5 font-mono text-[10px] tracking-[0.16em] text-ink-faint sm:p-6">
            已经是第一件展品
          </p>
        )
      }
      {
        neighbors.next ? (
          <a
            href={`/toys/${neighbors.next.id}/`}
            class="group flex flex-col items-end gap-2 bg-cream p-5 text-right transition-colors hover:bg-paper sm:p-6"
          >
            <span class="font-mono text-[9px] tracking-[0.2em] text-ink-faint">
              NEXT · 下一件 <span aria-hidden="true">→</span>
            </span>
            <span class="font-display text-xl leading-tight text-ink transition-colors group-hover:text-vermilion">
              {neighbors.next.name}
            </span>
            <span class="font-mono text-[9px] tracking-[0.14em] text-ink-faint">
              {neighbors.next.category} · {yearsLabel(neighbors.next)}
            </span>
          </a>
        ) : (
          <p class="flex items-center justify-end bg-cream p-5 text-right font-mono text-[10px] tracking-[0.16em] text-ink-faint sm:p-6">
            已经是最后一件展品
          </p>
        )
      }
    </div>

    <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/toys/"
        class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-ink-soft transition-colors hover:text-vermilion"
      >
        <span aria-hidden="true">←</span> 返回记忆博物馆，继续逛
      </a>
      <a
        href="/about/#comments"
        class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-ink-soft transition-colors hover:text-vermilion"
      >
        这件东西你也玩过？去留言板说一句 <span aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</BaseLayout>
